<%
  function esc(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function getStatusLabel(value) {
    const status = String(value ?? "").trim();
    if (status === "0") return "Pendiente";
    if (status === "1") return "Subido";
    if (status === "2") return "Rechazado";
    if (status === "3") return "Subsanado";
    return "Sin clasificar";
  }

  function getStatusTone(value) {
    const status = String(value ?? "").trim();
    if (status === "0") return "tone-gray";
    if (status === "1") return "tone-blue";
    if (status === "2") return "tone-red";
    if (status === "3") return "tone-green";
    return "tone-slate";
  }

  function getStatusGuide(value) {
    const status = String(value ?? "").trim();
    if (status === "3") return "Evidencia subsanada";
    if (status === "2") return "Evidencia rechazada";
    if (status === "1") return "Evidencia subida";
    if (status === "0") return "Pendiente";
    return "";
  }

  const grupos = (reporte && Array.isArray(reporte.grupos)) ? reporte.grupos : [];
  const items = (reporte && Array.isArray(reporte.items)) ? reporte.items : [];
  const resumen = (reporte && reporte.resumen) ? reporte.resumen : {};
  const filtros = (reporte && reporte.filtros) ? reporte.filtros : {};
  const catalogos = (reporte && reporte.catalogos) ? reporte.catalogos : {};
  const tiendasCatalogo = Array.isArray(catalogos.tiendas) ? catalogos.tiendas : [];
  const razonesCatalogo = Array.isArray(catalogos.razonesSociales) ? catalogos.razonesSociales : [];
  const municipiosCatalogo = Array.isArray(catalogos.municipios) ? catalogos.municipios : [];
  function buildPdfUrl(extra) {
    const params = new URLSearchParams();
    const base = {
      tienda: filtros.tienda || "",
      razonSocial: filtros.razonSocial || "",
      municipio: filtros.municipio || "",
    };
    const merged = Object.assign({}, base, extra || {});
    if (merged.tienda) params.set("tienda", merged.tienda);
    if (merged.razonSocial) params.set("razonSocial", merged.razonSocial);
    if (merged.municipio) params.set("municipio", merged.municipio);
    return `/solventaciones/pdf${params.toString() ? `?${params.toString()}` : ""}`;
  }
  const pdfActualUrl = buildPdfUrl();
  const titulo = filtros.tienda
    ? `SOLVENTACIONES | TIENDA ${filtros.tienda}`
    : filtros.razonSocial && filtros.municipio
      ? `SOLVENTACIONES | ${filtros.razonSocial} - ${filtros.municipio}`
      : filtros.razonSocial
        ? `SOLVENTACIONES | ${filtros.razonSocial}`
        : "REPORTE DE SOLVENTACIONES";
%>
<!DOCTYPE html>
<html lang="es">
  <head>
    <base target="_top">
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" href="/img/Logo%20sin%20fondo%203D%20HD.png" />
    <link rel="shortcut icon" type="image/png" href="/img/Logo%20sin%20fondo%203D%20HD.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= esc(titulo) %></title>
    <style>
      * { box-sizing: border-box; }

      :root {
        --brand: #b3202a;
        --brand-2: #1f4e79;
        --bg: #eef3f8;
        --paper: #ffffff;
        --text: #243040;
        --muted: #64748b;
        --line: #d9e2ee;
        --soft: #f7fbff;
      }

      body {
        margin: 0;
        font-family: Arial, sans-serif;
        color: var(--text);
        background:
          radial-gradient(circle at top left, rgba(179, 32, 42, 0.08), transparent 28%),
          radial-gradient(circle at bottom right, rgba(31, 78, 121, 0.10), transparent 24%),
          linear-gradient(135deg, #dde7f2 0%, #f7fafc 100%);
      }

      @page {
        size: Letter;
        margin: 0.25in;
      }

      .page {
        max-width: 1180px;
        margin: 24px auto;
        padding: 28px;
      }

      .sheet {
        background: var(--paper);
        border-radius: 16px;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.10);
        border: 1px solid rgba(31, 78, 121, 0.12);
        overflow: hidden;
      }

      .hero {
        padding: 26px 28px 18px;
        background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border-bottom: 2px solid rgba(179, 32, 42, 0.14);
      }

      .hero-top {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        align-items: flex-start;
        flex-wrap: wrap;
      }

      .brand {
        display: flex;
        gap: 14px;
        align-items: center;
      }

      .brand-mark {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--brand), #8f1d25);
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 800;
        letter-spacing: 0.08em;
      }

      .brand h1 {
        margin: 0;
        font-size: 1.1rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .brand p {
        margin: 4px 0 0;
        color: var(--muted);
        font-size: 0.82rem;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 0.74rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 700;
        background: #edf4fb;
        color: var(--brand-2);
        border: 1px solid #d6e4f3;
      }

      .chip-brand {
        background: #fff0f1;
        color: var(--brand);
        border-color: #f2c7cb;
      }

      .toolbar {
        margin-top: 18px;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
      }

      .field {
        background: #f8fafc;
        border: 1px solid #e4edf7;
        border-radius: 12px;
        padding: 12px;
      }

      .field label {
        display: block;
        margin-bottom: 8px;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
        font-weight: 700;
      }

      .field input {
        width: 100%;
        border: 1px solid #cfdbea;
        border-radius: 10px;
        padding: 10px 12px;
        outline: none;
        background: #fff;
        font-size: 0.92rem;
      }

      .actions {
        grid-column: span 4;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
      }

      .actions a,
      .actions button {
        appearance: none;
        border: 0;
        border-radius: 10px;
        padding: 11px 16px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.72rem;
        cursor: pointer;
        text-decoration: none;
      }

      .primary {
        background: var(--brand);
        color: #fff;
      }

      .secondary {
        background: #eef4fb;
        color: var(--brand-2);
        border: 1px solid #d6e4f3;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        padding: 18px 28px 0;
      }

      .stat {
        padding: 14px 16px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--soft);
      }

      .stat .label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
        font-weight: 700;
      }

      .stat .value {
        margin-top: 8px;
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--brand-2);
      }

      .content {
        padding: 18px 28px 28px;
      }

      .section-title {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: baseline;
        margin-bottom: 14px;
      }

      .section-title h2 {
        margin: 0;
        font-size: 0.92rem;
        letter-spacing: 0.10em;
        text-transform: uppercase;
      }

      .section-title span {
        color: var(--muted);
        font-size: 0.78rem;
      }

      .group {
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 16px;
        margin-bottom: 14px;
        background: linear-gradient(180deg, #fff 0%, #fbfdff 100%);
        page-break-inside: avoid;
      }

      .group-head {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: flex-start;
        margin-bottom: 12px;
      }

      .group-title {
        font-size: 1rem;
        font-weight: 800;
        color: var(--brand-2);
        margin: 0;
      }

      .group-subtitle {
        margin-top: 4px;
        color: var(--muted);
        font-size: 0.8rem;
      }

      .group-count {
        background: #f1f5fb;
        color: var(--brand-2);
        border: 1px solid #d8e3f2;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        white-space: nowrap;
      }

      .items {
        display: grid;
        gap: 10px;
      }

      .item {
        border: 1px solid #e4ecf5;
        background: #ffffff;
        border-radius: 12px;
        padding: 12px 14px;
      }

      .item-top {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: flex-start;
        margin-bottom: 8px;
      }

      .item-title {
        font-weight: 800;
        font-size: 0.92rem;
      }

      .item-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 8px;
        margin-top: 8px;
        color: var(--muted);
        font-size: 0.76rem;
      }

      .tag {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border-radius: 999px;
        border: 1px solid #d8e3f2;
        background: #f6f9fe;
        color: var(--brand-2);
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .tag-brand {
        background: #fff0f1;
        border-color: #f0c6cb;
        color: var(--brand);
      }

      .tag-link {
        text-decoration: none;
        color: inherit;
      }

      .tag-link:hover .tag {
        filter: brightness(0.98);
        transform: translateY(-1px);
      }

      .desc {
        margin: 8px 0 0;
        font-size: 0.82rem;
        line-height: 1.5;
        color: #3a4a5c;
        white-space: pre-wrap;
      }

      .incidencias {
        display: grid;
        gap: 12px;
        margin-top: 12px;
      }

      .incidencia {
        border-top: 1px solid #e6edf6;
        padding-top: 12px;
      }

      .incidencia:first-child {
        border-top: 0;
        padding-top: 0;
      }

      .incidencia-head {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: flex-start;
        margin-bottom: 6px;
      }

      .incidencia-title {
        font-weight: 800;
        color: var(--text);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }

      .incidencia-guide {
        display: inline-block;
        margin-bottom: 4px;
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--brand);
      }
      .incidencia-guide.tone-gray { color: #64748b; }
      .incidencia-guide.tone-blue { color: var(--brand-2); }
      .incidencia-guide.tone-red { color: var(--brand); }
      .incidencia-guide.tone-green { color: #1f7a4d; }

      .incidencia-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 8px;
        color: var(--muted);
        font-size: 0.74rem;
        margin-top: 6px;
      }

      .tag-estado.tone-gray { border-color: rgba(100, 116, 139, 0.22); color: #475569; }
      .tag-estado.tone-blue { border-color: rgba(31, 78, 121, 0.22); color: var(--brand-2); }
      .tag-estado.tone-red { border-color: rgba(179, 32, 42, 0.22); color: var(--brand); }
      .tag-estado.tone-green { border-color: rgba(31, 122, 77, 0.22); color: #1f7a4d; }
      .tag-estado.tone-slate { border-color: rgba(51, 65, 85, 0.20); color: var(--text); }

      .image-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 10px;
        margin-top: 10px;
      }

      .evidence-block {
        margin-top: 10px;
        break-inside: avoid;
        page-break-inside: avoid;
      }

      .image-card {
        display: block;
        border: 1px solid #dbe6f1;
        border-radius: 12px;
        overflow: hidden;
        background: #f8fbff;
        text-decoration: none;
      }

      .image-card.evidence-only {
        display: flex;
        flex-direction: column;
      }

      .image-card img {
        display: block;
        width: 100%;
        height: 160px;
        object-fit: cover;
      }

      .evidence-note {
        padding: 10px 12px 12px;
        border-top: 1px solid #e6edf6;
        background: #fff7f8;
      }

      .evidence-note.evidence-note--standalone {
        border: 1px solid #f0c3c8;
        border-radius: 10px;
        margin-bottom: 8px;
      }

      .image-card.evidence-only .evidence-note {
        border-top: 0;
        border-bottom: 1px solid #e6edf6;
      }

      .evidence-note .label {
        display: inline-block;
        margin-bottom: 6px;
        padding: 2px 8px;
        border-radius: 999px;
        background: #ffe8ea;
        color: var(--brand);
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .evidence-note .text {
        margin: 0;
        font-size: 0.78rem;
        line-height: 1.45;
        color: #334155;
        white-space: pre-wrap;
      }

      .image-fallback,
      .no-images {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 160px;
        padding: 14px;
        font-size: 0.78rem;
        color: var(--muted);
        background: #f8fbff;
      }

      @media print {
        body {
          background: #fff;
        }

        .page {
          margin: 0;
          padding: 0;
          max-width: none;
        }

        .sheet {
          border-radius: 0;
          box-shadow: none;
          border: 0;
        }

        .hero,
        .stats,
        .content,
        .footer {
          padding-left: 0.18in;
          padding-right: 0.18in;
        }
      }

      .empty {
        padding: 36px 24px;
        text-align: center;
        color: var(--muted);
        border: 1px dashed #bfd0e5;
        border-radius: 16px;
        background: #f9fbfe;
      }

      .footer {
        padding: 0 28px 28px;
        color: #8a96a8;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
      }

      @media (max-width: 900px) {
        .toolbar,
        .stats {
          grid-template-columns: 1fr 1fr;
        }

        .actions {
          grid-column: span 2;
        }
      }

      @media (max-width: 640px) {
        .page {
          margin: 0;
          padding: 0;
        }

        .sheet {
          border-radius: 0;
        }

        .hero,
        .stats,
        .content,
        .footer {
          padding-left: 16px;
          padding-right: 16px;
        }

        .toolbar,
        .stats {
          grid-template-columns: 1fr;
        }

        .actions {
          grid-column: span 1;
          justify-content: stretch;
          flex-direction: column;
        }

        .actions a,
        .actions button {
          width: 100%;
          text-align: center;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <div class="sheet">
        <section class="hero">
          <div class="hero-top">
            <div class="brand">
              <div class="brand-mark">EG</div>
              <div>
                <h1>Reporte de solventaciones</h1>
                <p>Ruta oficial para generar reportes por tienda, razon social o razon social + municipio.</p>
              </div>
            </div>
            <div style="display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end;">
              <span class="chip chip-brand">Datos reales</span>
              <span class="chip">Tabla: <%= esc(reporte.tableName || "STATUS SISTEMA PC") %></span>
            </div>
          </div>

          <form class="toolbar" method="get" action="/solventaciones/html">
            <div class="field">
              <label for="tienda">Tienda</label>
              <input id="tienda" name="tienda" list="tiendasCatalogo" value="<%= esc(filtros.tienda || "") %>" placeholder="Ej. 1016 LEY PLAZA FIESTA">
            </div>
            <div class="field">
              <label for="razonSocial">Razon social</label>
              <input id="razonSocial" name="razonSocial" list="razonesCatalogo" value="<%= esc(filtros.razonSocial || "") %>" placeholder="Ej. CASA LEY, S.A.P.I. DE C.V.">
            </div>
            <div class="field">
              <label for="municipio">Municipio</label>
              <input id="municipio" name="municipio" list="municipiosCatalogo" value="<%= esc(filtros.municipio || "") %>" placeholder="Ej. MAZATLAN">
            </div>
            <div class="actions">
              <a class="secondary" href="/solventaciones/html">Limpiar</a>
              <a class="secondary" href="<%= esc(pdfActualUrl) %>" target="_blank" rel="noreferrer">PDF actual</a>
              <button class="primary" type="submit">Generar reporte</button>
            </div>
          </form>
        </section>

        <section class="stats">
          <div class="stat">
            <div class="label">Registros visitados</div>
            <div class="value"><%= resumen.totalRegistros || 0 %></div>
          </div>
          <div class="stat">
            <div class="label">Tiendas</div>
            <div class="value"><%= resumen.totalTiendas || 0 %></div>
          </div>
          <div class="stat">
            <div class="label">Razon social</div>
            <div class="value"><%= resumen.totalRazonSociales || 0 %></div>
          </div>
          <div class="stat">
            <div class="label">Municipios</div>
            <div class="value"><%= resumen.totalMunicipios || 0 %></div>
          </div>
        </section>

        <section class="content">
          <div class="section-title">
            <h2>Detalle del reporte</h2>
            <span><%= items.length %> resultado(s) en <%= grupos.length %> grupo(s)</span>
          </div>

          <% if (reporte.advertencias && reporte.advertencias.length) { %>
            <div class="group" style="border-left: 5px solid #b3202a;">
              <div class="group-head">
                <div>
                  <div class="group-title">Aviso</div>
                  <div class="group-subtitle"><%= esc(reporte.advertencias[0]) %></div>
                </div>
                <div class="group-count">Referencia</div>
              </div>
            </div>
          <% } %>

          <% if (!grupos.length) { %>
            <div class="empty">
              No hay registros VISITADA o RECHAZADA que coincidan con los filtros actuales.
            </div>
          <% } %>

          <% grupos.forEach(function (grupo) { %>
            <article class="group">
              <div class="group-head">
                <div>
                  <h3 class="group-title"><%= esc(grupo.titulo) %></h3>
                  <div class="group-subtitle">
                    <% if (grupo.subtitulo && grupo.subtitulo.length) { %>
                      <%= esc(grupo.subtitulo.join(" - ")) %>
                    <% } else { %>
                      Generado desde datos de Sistema PC.
                    <% } %>
                  </div>
                </div>
                <div class="group-count"><%= grupo.items.length %> visita(s)</div>
              </div>

              <div class="items">
                <% grupo.items.forEach(function (item) { %>
                  <div class="item">
                    <div class="item-top">
                      <div>
                        <div class="item-title"><%= esc(item.sucursalNombre || item.razonSocial || item.tienda || "Sin nombre") %></div>
                        <div class="item-meta">
                          <% if (item.tienda) { %>
                            <a class="tag-link" href="<%= esc(buildPdfUrl({ tienda: item.tienda, razonSocial: '', municipio: '' })) %>" target="_blank" rel="noreferrer">
                              <span class="tag tag-brand">Tienda <%= esc(item.tienda) %></span>
                            </a>
                          <% } %>
                          <% if (item.razonSocial) { %>
                            <a class="tag-link" href="<%= esc(buildPdfUrl({ razonSocial: item.razonSocial, tienda: '', municipio: '' })) %>" target="_blank" rel="noreferrer">
                              <span class="tag"><%= esc(item.razonSocial) %></span>
                            </a>
                          <% } %>
                          <% if (item.municipioNombre) { %>
                            <a class="tag-link" href="<%= esc(buildPdfUrl({ municipio: item.municipioNombre, tienda: '', razonSocial: '' })) %>" target="_blank" rel="noreferrer">
                              <span class="tag"><%= esc(item.municipioNombre) %></span>
                            </a>
                          <% } %>
                          <% if (item.estatus) { %><span class="tag"><%= esc(item.estatus) %></span><% } %>
                        </div>
                      </div>
                      <div class="group-count">Solicitud <%= esc(item.solicitudId || "N/D") %></div>
                    </div>

                    <div class="item-meta">
                      <% if (item.sucursalId) { %><span>Sucursal ID: <strong><%= esc(item.sucursalId) %></strong></span><% } %>
                      <% if (item.estadoNombre) { %><span>Estado: <strong><%= esc(item.estadoNombre) %></strong></span><% } %>
                      <% if (item.registroFecha) { %><span>Registro: <strong><%= esc(item.registroFecha) %></strong></span><% } %>
                      <% if (item.vigenciaFecha) { %><span>Vigencia: <strong><%= esc(item.vigenciaFecha) %></strong></span><% } %>
                    </div>

                    <% if (item.motivo) { %>
                      <p class="desc"><strong>Motivo general:</strong> <%= esc(item.motivo) %></p>
                    <% } %>

                    <% if (item.errorIncidencias) { %>
                      <p class="desc" style="color:#b3202a;"><strong>Aviso:</strong> <%= esc(item.errorIncidencias) %></p>
                    <% } %>

                    <div class="incidencias">
                      <% if (Array.isArray(item.incidencias) && item.incidencias.length) { %>
                        <% item.incidencias.forEach(function (inc) {
                          const statusValue = inc.estatus !== undefined && inc.estatus !== null ? String(inc.estatus) : (inc.status !== undefined && inc.status !== null ? String(inc.status) : "");
                        %>
                          <div class="incidencia">
                            <div class="incidencia-head">
                              <div>
                                <% if (statusValue) { %><div class="incidencia-guide <%= getStatusTone(statusValue) %>"><%= esc(getStatusGuide(statusValue)) %></div><% } %>
                                <div class="incidencia-title"><%= esc(inc.titulo || "Sin titulo") %></div>
                                <div class="incidencia-meta">
                                  <% if (inc.incidencia_id) { %><span class="tag">Incidencia #<%= esc(inc.incidencia_id) %></span><% } %>
                                  <% if (statusValue) { %><span class="tag tag-estado <%= getStatusTone(statusValue) %>">Estatus <%= esc(statusValue) %> · <%= esc(getStatusLabel(statusValue)) %></span><% } %>
                                  <% if (inc.registro_fecha) { %><span class="tag">Registrada: <%= esc(inc.registro_fecha) %></span><% } %>
                                  <span class="tag">Fotos: <%= esc(String(inc.evidenciasCount ?? (inc.imagenes || []).length)) %></span>
                                </div>
                              </div>
                              <div class="group-count">Motivo</div>
                            </div>

                            <% if (inc.descripcion) { %>
                              <div class="desc" style="margin-top:6px;"><strong>Motivo:</strong> <%= esc(inc.descripcion) %></div>
                            <% } %>
                            <% const adjuntosIncidencia = Array.isArray(inc.adjuntosIncidencia) ? inc.adjuntosIncidencia : []; %>
                            <% if (adjuntosIncidencia.length) { %>
                              <div class="evidence-list">
                                <div class="evidence-block">
                                  <div class="image-grid">
                                    <% adjuntosIncidencia.forEach(function (img, idxImg) {
                                      const thumbSrc = img.thumbnailUrl || img.previewUrl || img.url_imagen || "";
                                      const fullSrc = img.url_imagen || img.url || thumbSrc;
                                      const caption = img.filename || `Adjunto ${idxImg + 1}`;
                                    %>
                                      <% if (fullSrc) { %>
                                        <a class="image-card" href="<%= esc(fullSrc) %>" target="_blank" rel="noreferrer">
                                          <% if (thumbSrc) { %>
                                            <img src="<%= esc(thumbSrc) %>" alt="<%= esc(caption) %>">
                                          <% } else { %>
                                            <div class="image-fallback">Sin miniatura</div>
                                          <% } %>
                                        </a>
                                      <% } else { %>
                                        <div class="image-card">
                                          <div class="image-fallback">Sin archivo adjunto</div>
                                        </div>
                                      <% } %>
                                    <% }); %>
                                  </div>
                                  <div class="evidence-note evidence-note--standalone">
                                    <span class="label">Evidencia fotográfica</span>
                                  </div>
                                </div>
                              </div>
                            <% } %>
                            <% const evidenciasDetalle = Array.isArray(inc.evidenciasDetalle) ? inc.evidenciasDetalle : (Array.isArray(inc.imagenes) ? inc.imagenes : []); %>
                            <% if (evidenciasDetalle.length) { %>
                              <div class="evidence-list">
                                <% evidenciasDetalle.forEach(function (ev) {
                                  const files = Array.isArray(ev.files) ? ev.files : [];
                                  const evidenceText = String(ev.descripcion || ev.observacion || ev.comentario || "").trim();
                                %>
                                  <div class="evidence-block">
                                    <div class="image-grid">
                                      <% if (files.length) { %>
                                        <% files.forEach(function (file, idxFile) {
                                          const thumbSrc = file.thumbnailUrl || file.previewUrl || file.url_imagen || "";
                                          const fullSrc = file.url_imagen || file.url || thumbSrc;
                                          const caption = file.filename || `Archivo ${idxFile + 1}`;
                                        %>
                                          <% if (fullSrc) { %>
                                            <a class="image-card" href="<%= esc(fullSrc) %>" target="_blank" rel="noreferrer">
                                              <% if (thumbSrc) { %>
                                                <img src="<%= esc(thumbSrc) %>" alt="<%= esc(caption) %>">
                                              <% } else { %>
                                                <div class="image-fallback">Sin miniatura</div>
                                              <% } %>
                                            </a>
                                          <% } else { %>
                                            <div class="image-card">
                                              <div class="image-fallback">Sin archivo adjunto</div>
                                            </div>
                                          <% } %>
                                        <% }); %>
                                      <% } else { %>
                                        <div class="image-card">
                                          <div class="image-fallback">Sin archivo adjunto</div>
                                        </div>
                                      <% } %>
                                    </div>
                                    <div class="evidence-note evidence-note--standalone">
                                      <span class="label"><%= esc(ev.is_observacion ? "Observación" : "Descripción de evidencia") %></span>
                                      <p class="text"><%= esc(evidenceText || "Sin descripción") %></p>
                                    </div>
                                  </div>
                                <% }); %>
                              </div>
                            <% } %>
                          </div>
                        <% }); %>
                      <% } else { %>
                        <div class="desc">Sin incidencias asociadas para esta visita.</div>
                      <% } %>
                    </div>
                  </div>
                <% }); %>
              </div>
            </article>
          <% }); %>
        </section>

        <datalist id="tiendasCatalogo">
          <% tiendasCatalogo.forEach(function (tienda) { %>
            <option value="<%= esc(tienda) %>"></option>
          <% }); %>
        </datalist>

        <datalist id="razonesCatalogo">
          <% razonesCatalogo.forEach(function (razon) { %>
            <option value="<%= esc(razon) %>"></option>
          <% }); %>
        </datalist>

        <datalist id="municipiosCatalogo">
          <% municipiosCatalogo.forEach(function (municipio) { %>
            <option value="<%= esc(municipio) %>"></option>
          <% }); %>
        </datalist>

        <div class="footer">
          Reporte generado desde Desarrollo EG Consultores Â· <%= new Date().getFullYear() %>
        </div>
      </div>
    </div>
  </body>
</html>


