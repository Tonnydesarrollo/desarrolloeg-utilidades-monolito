    <% if (!(typeof data !== "undefined" && data && data.isPdfExport)) { %>
      <script>
        (function(){
          var drawer = document.querySelector('[data-cotizacion-drawer]');
          var openButtons = Array.from(document.querySelectorAll('[data-cotizacion-drawer-open]'));
          var closeTargets = Array.from(document.querySelectorAll('[data-cotizacion-drawer-close]'));
          var backdrop = document.querySelector('[data-cotizacion-drawer-backdrop]');
          var closeTimer = null;
          if (!drawer || openButtons.length === 0) return;

          function openDrawer(){
            if (closeTimer) window.clearTimeout(closeTimer);
            drawer.hidden = false;
            drawer.removeAttribute('inert');
            if (backdrop) backdrop.hidden = false;
            document.body.classList.add('cotizacion-drawer-open');
            openButtons.forEach(function(btn){ btn.setAttribute('aria-expanded', 'true'); });
            requestAnimationFrame(function(){
              drawer.classList.add('is-open');
              if (backdrop) backdrop.classList.add('is-open');
              var closeButton = drawer.querySelector('[data-cotizacion-drawer-close]');
              if (closeButton) closeButton.focus();
            });
          }

          function closeDrawer(){
            drawer.classList.remove('is-open');
            if (backdrop) backdrop.classList.remove('is-open');
            document.body.classList.remove('cotizacion-drawer-open');
            drawer.setAttribute('inert', '');
            openButtons.forEach(function(btn){ btn.setAttribute('aria-expanded', 'false'); });
            closeTimer = window.setTimeout(function(){
              drawer.hidden = true;
              if (backdrop) backdrop.hidden = true;
              closeTimer = null;
            }, 220);
          }

          openButtons.forEach(function(btn){ btn.addEventListener('click', openDrawer); });
          closeTargets.forEach(function(btn){ btn.addEventListener('click', closeDrawer); });
          if (backdrop) backdrop.addEventListener('click', closeDrawer);
          document.addEventListener('keydown', function(event){
            if (event.key === 'Escape' && !drawer.hidden) closeDrawer();
          });
          drawer.setAttribute('inert', '');
        })();

        (function() {
          var desglosePipc = document.getElementById('desglosePipc');
          var desgloseCapacitaciones = document.getElementById('desgloseCapacitaciones');
          var desgloseCatalogoCodigo = document.getElementById('desgloseCatalogoCodigo');
          var desgloseCatalogoDescripcion = document.getElementById('desgloseCatalogoDescripcion');
          var mostrarDireccionSucursal = document.getElementById('mostrarDireccionSucursal');
          var formaPagoSelect = document.getElementById('formaPagoSelect');
          var centroSelect = document.getElementById('cotizacionCentroSelect');
          var centroSelectTopBar = document.getElementById('cotizacionCentroSelectTopBar');

          var currentParams = new URLSearchParams(window.location.search);

          if (desglosePipc) {
            var rawD = (currentParams.get('desglose') || '').toLowerCase();
            desglosePipc.checked = currentParams.get('pipc') === '1' || rawD.includes('pipc');
          }
          if (desgloseCapacitaciones) {
            var rawD2 = (currentParams.get('desglose') || '').toLowerCase();
            desgloseCapacitaciones.checked = currentParams.get('capacitaciones') === '1' || currentParams.get('capacitacion') === '1' || rawD2.includes('capacitac');
          }
          if (desgloseCatalogoCodigo) {
            desgloseCatalogoCodigo.checked = currentParams.get('codigo') === '1' || currentParams.get('mostrarCodigo') === '1';
          }
          if (desgloseCatalogoDescripcion) {
            desgloseCatalogoDescripcion.checked = currentParams.get('descripcion') === '1' || currentParams.get('mostrarDescripcion') === '1';
          }
          if (mostrarDireccionSucursal) {
            mostrarDireccionSucursal.checked = currentParams.get('direccion') === '1' || currentParams.get('mostrarDireccion') === '1';
          }

          function applyChanges() {
            var params = new URLSearchParams(window.location.search);

            if (formaPagoSelect) {
              if (formaPagoSelect.value === 'una_exhibicion') params.set('formaPago', 'una_exhibicion');
              else params.delete('formaPago');
            }

            var arr = [];
            if (desglosePipc && desglosePipc.checked) arr.push('pipc');
            if (desgloseCapacitaciones && desgloseCapacitaciones.checked) arr.push('capacitaciones');
            if (arr.length > 0) params.set('desglose', arr.join(','));
            else params.delete('desglose');
            params.delete('pipc');
            params.delete('capacitaciones');
            params.delete('capacitacion');

            if (desgloseCatalogoCodigo) {
              if (desgloseCatalogoCodigo.checked) params.set('codigo', '1');
              else params.delete('codigo');
            }
            if (desgloseCatalogoDescripcion) {
              if (desgloseCatalogoDescripcion.checked) params.set('descripcion', '1');
              else params.delete('descripcion');
            }
            if (mostrarDireccionSucursal) {
              if (mostrarDireccionSucursal.checked) params.set('direccion', '1');
              else params.delete('direccion');
            }

            var targetCentro = (centroSelectTopBar ? centroSelectTopBar.value : '') || (centroSelect ? centroSelect.value : '');
            if (targetCentro) params.set('centro', targetCentro);
            else params.delete('centro');

            params.delete('autoprint');
            window.location.search = params.toString();
          }

          if (formaPagoSelect) formaPagoSelect.addEventListener('change', applyChanges);
          if (desglosePipc) desglosePipc.addEventListener('change', applyChanges);
          if (desgloseCapacitaciones) desgloseCapacitaciones.addEventListener('change', applyChanges);
          if (desgloseCatalogoCodigo) desgloseCatalogoCodigo.addEventListener('change', applyChanges);
          if (desgloseCatalogoDescripcion) desgloseCatalogoDescripcion.addEventListener('change', applyChanges);
          if (mostrarDireccionSucursal) mostrarDireccionSucursal.addEventListener('change', applyChanges);
          if (centroSelect) centroSelect.addEventListener('change', applyChanges);
          if (centroSelectTopBar) centroSelectTopBar.addEventListener('change', applyChanges);

          <% if (typeof autoprint !== "undefined" && autoprint) { %>
          window.addEventListener('load', function() {
            setTimeout(function() { window.print(); }, 400);
          });
          <% } %>
        })();
      </script>
      <script src="/ui/portal-shell.js?v=20260901b" defer></script>
    <% } %>
  </body>
</html>

