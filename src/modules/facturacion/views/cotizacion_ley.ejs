    <% /* helper formato moneda */ %>
    <%  function fmtMoney(v){ 
var n = Number(v||0); if(!isFinite(n)) n=0; return n.toLocaleString('es-MX',{minimumFractionDigits:2, maximumFractionDigits:2}); } %>
    <%
      function fmtDate(v) {
        var text = String(v || '').trim();
        if (!text) return '';
        var isoLike = text.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
        if (isoLike) {
          return isoLike[3].padStart(2, '0') + '/' + isoLike[2].padStart(2, '0') + '/' + isoLike[1];
        }
        var slash = text.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})$/);
        if (slash) {
          var a = Number(slash[1]);
          var b = Number(slash[2]);
          var year = slash[3];
          var month = a > 12 && b <= 12 ? b : a;
          var day = a > 12 && b <= 12 ? a : b;
          return String(day).padStart(2, '0') + '/' + String(month).padStart(2, '0') + '/' + year;
        }
        var date = new Date(text);
        if (!isNaN(date.getTime())) {
          return new Intl.DateTimeFormat('es-MX', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(date);
        }
        return text;
      }
    %>

    <% 
      /* Detección de todas lineas servicio (mantiene tu lógica) */
      function isLineService(ln){
        if(!ln) return false;
        var candidates = [ln.tipo, ln.TIPO, ln.tipoProducto, (ln.raw && ln.raw.TIPO), (ln.raw && ln.raw.tipo)];
        for(var i=0;i<candidates.length;i++){
          var v = candidates[i];
          if(v !== undefined && v !== null && String(v).trim() !== ''){
            var s = String(v).trim().toUpperCase();
            if(s.indexOf('SERV') !== -1 || s === 'SERVICIO' || s === 'SERVICIOS') return true;
          }
        }
        var desc = String(ln.descripcion || ln.productoNombre || '').toUpperCase();
        if(desc.indexOf('SERVICIO') !== -1 || desc.indexOf('PAGO') !== -1 || desc.indexOf('PIPC') !== -1) return true;
        return false;
      }

      var allServicios = true;
      var foundAnyLine = false;
      if(data && data.centros && data.centros.length){
        for(var ci=0; ci<data.centros.length; ci++){
          var c = data.centros[ci] || {};
          var lines = c.lineas || [];
          for(var li=0; li<lines.length; li++){
            foundAnyLine = true;
            if(!isLineService(lines[li])){
              allServicios = false;
              break;
            }
          }
          if(!allServicios) break;
        }
      } else {
        allServicios = false;
      }
      if(!foundAnyLine) allServicios = false;
      var showQtyAndUnit = !allServicios;
