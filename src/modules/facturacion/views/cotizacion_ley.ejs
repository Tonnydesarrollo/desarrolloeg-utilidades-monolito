      .fecha-label{margin-top:4px;}

      h2{margin:15px 0 8px;font-size:0.86rem;text-transform:uppercase;color:#333;letter-spacing:0.04em}
      
      /* TABLA DE DETALLES (Se mantienen igual) */
      table{width:100%;border-collapse:collapse;font-size:0.72rem;margin-bottom:15px;table-layout:fixed;border:none;}
      thead{display:table-header-group;}
      tbody{display:table-row-group;}
      tr{page-break-inside:avoid;break-inside:avoid;}
      thead th{
        background:#f0f3f8;
        border:none;
        border-bottom:2px solid #b3202a;
        border-top:1px solid #dfe6ef;
        border-right:1px solid #dfe6ef;
        padding:7px 4px;
        text-transform:uppercase;
        font-size:0.60rem;
        line-height:1.0;
        letter-spacing:0.03em;
        white-space:normal;
        word-break:keep-all;
        color:#333;
        font-weight:700;
        text-align:center !important;
        vertical-align:middle !important;
      }
      thead th > span{
        display:block;
        width:100%;
        text-align:center !important;
      }
      thead th.cantidad-col{
        text-align:center !important;
        padding-left:0;
        padding-right:0;
        width:7%;
      }
      thead th.cantidad-col > span{
        display:flex;
        align-items:center;
        justify-content:center;
        white-space:nowrap;
        letter-spacing:0.02em;
        width:100%;
      }
      thead th:last-child{
        border-right:none;
      }
      th,td{border:none;padding:6px;vertical-align:top;}
      tbody tr:nth-child(odd){background:#f9f9f9}
      tbody td{
        border-bottom:1px solid #eee;
        border-right:1px solid #f0f0f0;
      }
      tbody td:last-child{
        border-right:none;
      }

      col.tienda { width:8%; }
      col.sucursal { width:17%; }
      col.desc { width:31%; }
      col.cantidad { width:7%; }
      col.precioUnit { width:12%; }
      col.subtotal { width:10%; }
      col.iva { width:8%; }
      col.total { width:8%; }
      .desc-cell {
        display: block;
        overflow: visible;
        text-overflow: clip;
        word-break:break-word;
        font-size:0.72rem;
        line-height:1.15;
      }
      .tienda-cell{font-weight:600;font-size:0.76rem}
      .sucursal-cell{font-weight:600;font-size:0.78rem}
      .sucursal-domicilio{font-size:0.62rem;color:#666;margin-top:2px;}
      .tipo-linea{font-size:0.64rem;color:#666;margin-top:4px}
      td.monto{font-variant-numeric:tabular-nums;white-space:nowrap;text-align:right;font-size:0.76rem;font-weight:500;}

      /* SECCIÓN INFERIOR: Totales y Firma en paralelo (Se mantienen igual) */
      .bottom-section{
        display:flex;
        justify-content:space-between;
        align-items:flex-end;
        margin-top:20px;
        page-break-inside:avoid;
      }
      .firma-wrapper{flex-basis: 40%; min-width: 250px; text-align: center; order: 1;}
      .totales-wrapper{flex-basis: 45%; min-width: 220px; text-align: right; order: 2;}
      .totales{font-size:0.78rem;width:100%;}
      .totales-row{display:flex;justify-content:space-between;padding:4px 0}
      .totales-label{color:#555;font-size:0.76rem;padding-right:12px;white-space:nowrap}
      .totales-value{text-align:right;min-width:100px;font-variant-numeric:tabular-nums;font-size:0.8rem;font-weight:600;}
      .totales-total{
        border-top:2px solid #b3202a;
        margin-top:8px;
        padding-top:8px;
        font-weight:700;
        font-size:0.9rem;
      }
      .importe-letra{
        text-align:left;
        white-space:normal;
        font-size:0.74rem;
        margin-top:10px;
        padding:4px 0;
        border-top:1px solid #ddd;
      }

      /* BLOQUE DE FIRMA ADAPTADO */
      .firma-block{
        text-align:center;
        page-break-inside:avoid;
        margin-top: 15px;
        width: 100%;
        max-width: 280px; /* Permitir un ancho un poco mayor */
        margin-left: auto;
        margin-right: auto;
      }
      /* 1. Imagen de firma más grande */
      .firma-block img{
        max-height:65px; /* Aumentado de 50px a 65px */
        display:block;
        margin:0 auto 4px; /* Pequeño margen debajo de la imagen */
        width: auto;
      }

      /* 2. Nueva clase para la línea divisoria: Va justo debajo de la imagen */
      .firma-linea{
        border-top: 1px solid #222;
        width: 100%;
        margin: 0 auto;
        height: 1px;
        margin-bottom: 6px; /* Espacio entre la línea y el texto */
      }

      /* 3. Contenedor del nombre (va debajo de la línea) */
      .firma-info{
        padding-top: 0; /* Ya no necesita padding, va después de la línea */
        width: 100%;
        margin: 0 auto;
      }
      /* Ajuste de texto según tu ejemplo */
      .firma-nombre{font-weight: 700; margin-bottom: 0; padding-top: 0; text-transform: uppercase; font-size: 0.8rem;}
      .firma-puesto{font-size: 0.68rem; color: #555; margin-bottom: 0;}

      /* FOOTER (Se mantienen igual) */
      .footer-bar{
        position:relative;
        margin-top:auto;
        left:0;
        right:0;
        min-height:12mm;
        background:#b3202a;
        color:#fff;
        font-size:0.68rem;
        display:flex;
        align-items:center;
        padding:1.8mm 10mm;
        z-index:2;
      }
      .footer-bar-inner{
        display:flex;
        width:100%;
        justify-content:space-between;
        gap:12px;
        flex-wrap:wrap;
        line-height:1.2;
      }

      /* MEDIA PRINT (Ajuste de tamaño de imagen para impresión) */
@media print{
  *{-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important;color-adjust:exact!important}
  .cotizacion-sidebar{display:none!important}
  .botonera{display:none!important}
  .desglose-toolbar{display:none!important}
  .cotizacion-options-fab{display:none!important}
  .cotizacion-print-fab{display:none!important}
  .cotizacion-drawer-backdrop{display:none!important}
  .cotizacion-layout{display:block!important;padding:0!important}
  .cotizacion-document{display:block!important}
  .page{margin:0;box-shadow:none;border-radius:0;padding:5mm 5mm 10mm;display:block!important;overflow:visible!important;max-width:none!important}
  .content{display:block!important;overflow:visible!important}
