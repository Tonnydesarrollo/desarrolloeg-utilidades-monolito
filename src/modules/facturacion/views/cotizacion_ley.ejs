      /* RESET Y CONFIGURACIÓN DE PÁGINA (Se mantienen igual) */
      *{box-sizing:border-box}
      @page{size:letter;margin:10mm 8mm 28mm}
      html,body{margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;color:#222;background:transparent;font-size:13px}

      /* CONTENEDOR PRINCIPAL (Se mantienen igual) */
      .page{
        width:215.9mm;
        max-width:215.9mm;
        margin:5mm auto;
        padding:8mm 10mm 28mm;
        background:#fff;
        border-radius:6px;
        position:relative;
        display:flex;
        flex-direction:column;
        box-shadow:0 6px 18px rgba(0,0,0,0.08);
        overflow:hidden;
      }
      .cotizacion-layout{
        display:flex;
        align-items:flex-start;
        gap:18px;
        padding:10px 14px 14px;
      }
      .cotizacion-sidebar{
        width:min(360px, calc(100vw - 24px));
        flex:0 0 auto;
        display:flex;
        flex-direction:column;
        gap:10px;
        position:fixed;
        inset:12px auto 12px 12px;
        z-index:120;
        max-height:calc(100dvh - 24px);
        overflow:auto;
        padding:14px;
        border-radius:24px;
        border:1px solid rgba(26,42,58,0.12);
        background:rgba(255,255,255,0.94);
        box-shadow:0 28px 80px rgba(0,31,84,0.22);
        transform:translateX(-16px) scale(0.96);
        opacity:0;
        pointer-events:none;
        transition:transform 220ms ease, opacity 220ms ease, background 220ms ease;
      }
      .cotizacion-sidebar.is-open{
        transform:translateX(0) scale(1);
        opacity:1;
        pointer-events:auto;
        background:rgba(255,255,255,0.98);
      }
      .cotizacion-sidebar__top{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:10px;
        margin-bottom:2px;
        padding-bottom:10px;
        border-bottom:1px solid rgba(26,42,58,0.08);
      }
      .cotizacion-sidebar__top strong{
        color:#1f2d3d;
        font-family:'Montserrat',sans-serif;
        font-size:0.82rem;
        font-weight:900;
        letter-spacing:0.08em;
        text-transform:uppercase;
      }
      .cotizacion-sidebar .botonera{
        text-align:left;
        margin-bottom:0;
        gap:8px !important;
      }
      .cotizacion-sidebar .botonera a,
      .cotizacion-sidebar .botonera button{
        width:100%;
        border-radius:999px;
        min-height:42px;
      }
      .cotizacion-sidebar .desglose-toolbar{
        margin:0;
      }
      .cotizacion-options-fab{
        position:fixed;
        left:12px;
        top:12px;
        z-index:130;
        min-height:44px;
        padding:0 14px;
        border-radius:999px;
        box-shadow:0 16px 34px rgba(26,42,58,0.18);
      }
      .cotizacion-print-fab{
        position:fixed;
        left:12px;
        top:64px;
        z-index:129;
        min-height:44px;
        padding:0 14px;
        border-radius:999px;
        box-shadow:0 16px 34px rgba(26,42,58,0.18);
      }
      .cotizacion-drawer-backdrop{
        position:fixed;
        inset:0;
        z-index:115;
        background:rgba(8,20,46,0.28);
        backdrop-filter:blur(6px);
        opacity:0;
        pointer-events:none;
        transition:opacity 220ms ease;
      }
      .cotizacion-drawer-backdrop.is-open{
        opacity:1;
        pointer-events:auto;
      }
      .cotizacion-document{
        flex:1;
        min-width:0;
        display:flex;
        justify-content:center;
      }
      .page{
        width:100%;
        max-width:215.9mm;
        margin:0;
      }
      .content{position:relative;z-index:1;padding-bottom:0;flex:1}
      
      /* BOTONERA (Se mantienen igual) */
      .botonera{text-align:right;margin-bottom:12px}
      button{padding:8px 12px;border:1px solid #b3202a;background:#fff;border-radius:4px;cursor:pointer;font-weight:600;color:#b3202a;font-size:0.8rem}
      button:hover{background:#b3202a;color:#fff}

      /* HEADER (Se mantienen igual) */
      .header{
        display:flex;
        justify-content:space-between;
        align-items:flex-start;
        margin-bottom:10px;
        border-bottom:3px solid #b3202a;
        padding-bottom:10px;
      }
      .header-col{flex:1;min-width:0;padding:0 5px;}
      .header-left{text-align:left;}
      .logo-principal{max-height:55px;width:auto;display:block;}
      .proveedor-block{font-size:0.75rem;margin-top:4px;}
      .proveedor-nombre{font-weight:700;font-size:0.8rem;text-transform:uppercase}
      /* CENTRAR LOGO PRINCIPAL + TEXTO EN HEADER CENTER */
.header-center{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
}

      .empresa-logo{max-height:50px;max-width:160px;margin:0 auto 4px;object-fit:contain}
      .empresa-nombre{font-weight:700;font-size:0.9rem;text-transform:uppercase;color:#b3202a}
      .header-right{text-align:right;font-size:0.75rem;}
