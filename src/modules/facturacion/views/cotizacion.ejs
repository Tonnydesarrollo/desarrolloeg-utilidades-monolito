      /* DetecciÃ³n de todas lineas servicio (mantiene tu lÃ³gica) */
      function isLineService(ln){
        if(!ln) return false;
        var candidates = [ln.tipo, ln.TIPO, ln.tipoProducto, (ln.raw && ln.raw.TIPO), (ln.raw && ln.raw.tipo)];
        for(var i=0;i<candidates.length;i++){
          var v = candidates[i];
          if(v !== undefined && v !== null && String(v).trim() !== ''){
            var s = String(v).trim().toUpperCase();
            if(s.indexOf('SERV') !== -1 || s === 'SERVICIO' || s === 'SERVICIOS') return true;
          }
        }
        var desc = String(ln.descripcion || ln.productoNombre || '').toUpperCase();
        if(desc.indexOf('SERVICIO') !== -1 || desc.indexOf('PAGO') !== -1 || desc.indexOf('PIPC') !== -1) return true;
        return false;
      }

      var allServicios = true;
      var foundAnyLine = false;
      if(data && data.centros && data.centros.length){
        for(var ci=0; ci<data.centros.length; ci++){
          var c = data.centros[ci] || {};
          var lines = c.lineas || [];
          for(var li=0; li<lines.length; li++){
            foundAnyLine = true;
            if(!isLineService(lines[li])){
              allServicios = false;
              break;
            }
          }
          if(!allServicios) break;
        }
      } else {
        allServicios = false;
      }
      if(!foundAnyLine) allServicios = false;
      var showQtyAndUnit = !allServicios;
    %>
<% 

function shouldOmitLine(ln){

  

  if(!ln) return false;

  var desc = String(ln.descripcion || '').toUpperCase().trim();
  var precio = Number(ln.precioUnit || ln.subLinea || 0);

  var isPagoDerechos =
    desc === 'PAGO DE DERECHOS ESTATAL' ||
    desc === 'PAGO DE DERECHOS MUNICIPAL';

  return isPagoDerechos && precio === 0;
}
%>

