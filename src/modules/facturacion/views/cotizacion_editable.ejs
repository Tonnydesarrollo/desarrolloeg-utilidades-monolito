<body class="portal-shell portal-cotizaciones portal-facturacion">
  <a class="skip-link" href="#cotizaciones-main">Saltar al contenido principal</a>
  <main id="cotizaciones-main" class="quote-shell">
    <header class="quote-hero"><div class="quote-eyebrow">Comercial</div><h1>Cotizaciones</h1><p>Consulta documentos existentes o inicia una cotización nueva mediante recorridos claramente separados.</p></header>
    <nav class="quote-tabs" aria-label="Vistas de cotizaciones" role="tablist"><button class="quote-tab" type="button" role="tab" data-tab="list" aria-selected="true">Consultar cotizaciones</button><button class="quote-tab" type="button" role="tab" data-tab="editor" aria-selected="false">Crear cotización</button></nav>
    <section class="quote-panel" data-panel="list"><div class="quote-panel-head"><div><h2>Cotizaciones guardadas</h2><p>Abre el documento para consultarlo o entra a edición mediante su acción independiente.</p></div><div class="quote-field quote-search"><label for="quoteSearch">Buscar</label><input id="quoteSearch" type="search" placeholder="Empresa, título o fecha"></div></div><div id="quoteList" class="quote-list"><div class="quote-loading">Cargando cotizaciones...</div></div></section>
    <section class="quote-editor" data-panel="editor" hidden>
      <header class="quote-editor-head"><div><h2 id="editorTitle">Nueva cotización</h2><p id="editorSubtitle">Configura el cliente, los centros, conceptos y la firma.</p></div><div class="quote-actions"><a id="documentLink" class="quote-button quote-button--dark" href="#" target="_blank" hidden>Ver documento</a><button id="cancelEdit" class="quote-button" type="button">Cancelar</button></div></header>
      <form id="quoteForm" class="quote-form" novalidate>
        <section class="quote-section"><div class="quote-section-title"><h3>1. Cliente y firma</h3><div class="quote-client-mode"><button type="button" data-client-mode="registered" aria-pressed="true">Empresa registrada</button><button type="button" data-client-mode="external" aria-pressed="false">No registrada</button></div></div><div class="quote-grid"><div class="quote-field quote-span-2" data-registered><label for="companySelect">Empresa</label><select id="companySelect"><option value="">Seleccionar empresa</option></select></div><div class="quote-order-filters" data-registered><label class="quote-order-filter"><input id="withoutMunicipalOrder" type="checkbox"><span>Sin pedido municipal</span></label><label class="quote-order-filter"><input id="withoutStateOrder" type="checkbox"><span>Sin pedido estatal</span></label></div><div class="quote-field quote-span-2" data-external hidden><label for="recipientInput">Cotización dirigida a</label><input id="recipientInput" placeholder="Nombre de la persona o empresa"></div><div class="quote-field"><label for="quoteDate">Fecha</label><input id="quoteDate" type="date"></div><div class="quote-field"><label for="signatureSelect">Quién firma</label><select id="signatureSelect"><option value="">Seleccionar firma</option></select></div></div></section>
        <section class="quote-section"><div class="quote-section-title"><h3>2. Centros de trabajo</h3><span id="centerCount" class="quote-label">0 seleccionados</span></div><div data-registered><div class="quote-grid" style="margin-bottom:13px"><div class="quote-field"><label id="stateSelectLabel">Estados</label><details id="stateSelect" class="quote-multiselect"><summary id="stateSummary" aria-labelledby="stateSelectLabel">Todos los estados</summary><div id="stateOptions" class="quote-multiselect-options"></div></details></div><div class="quote-field"><label id="municipalitySelectLabel">Municipios</label><details id="municipalitySelect" class="quote-multiselect"><summary id="municipalitySummary" aria-labelledby="municipalitySelectLabel">Todos los municipios</summary><div id="municipalityOptions" class="quote-multiselect-options"></div></details></div><div class="quote-field quote-span-2"><label for="centerSearch">Buscar centro</label><input id="centerSearch" type="search" placeholder="Número, nombre o dirección"></div><div class="quote-center-toolbar"><span id="visibleCenterCount" class="quote-center-toolbar-copy">0 sucursales resultantes</span><div class="quote-center-toolbar-actions"><button id="selectAllCenters" class="quote-button quote-button--select-all" type="button">Seleccionar todas las resultantes</button><button id="clearVisibleCenters" class="quote-button" type="button">Quitar resultantes</button></div></div></div><div id="centerList" class="quote-centers"><div class="quote-empty">Selecciona una empresa para ver sus centros.</div></div></div><div class="quote-field" data-external hidden><label for="externalCenters">Centros de trabajo, uno por línea</label><textarea id="externalCenters" placeholder="Centro de trabajo norte&#10;Centro de trabajo sur"></textarea></div></section>
        <section class="quote-section" id="newConceptSection"><div class="quote-section-title"><h3>3. Conceptos</h3><span class="quote-label">Se aplicarán a todos los centros</span></div><div class="quote-field" style="margin-bottom:13px"><label for="conceptSearch">Buscar concepto</label><input id="conceptSearch" type="search" placeholder="Producto, servicio o código"></div><div id="conceptList" class="quote-concepts"></div></section>
        <section class="quote-section" id="editLinesSection" hidden><div class="quote-section-title"><h3>3. Conceptos por centro de trabajo</h3><span id="lineCount" class="quote-label"></span></div><div class="quote-bulk-add" aria-label="Agregar concepto a todos los centros"><div class="quote-field"><label for="bulkConceptSelect">Concepto para todos</label><select id="bulkConceptSelect"><option value="">Seleccionar concepto</option></select></div><div class="quote-field"><label for="bulkQuantity">Cantidad</label><input id="bulkQuantity" type="number" min="0" step="1" value="1"></div><div class="quote-field"><label for="bulkPrice">Precio</label><input id="bulkPrice" type="number" min="0" step=".01" value="0"></div><div class="quote-field"><label for="bulkIva">IVA (%)</label><input id="bulkIva" type="number" min="0" max="100" step="1" value="16"></div><button id="addConceptToAll" class="quote-button quote-button--dark" type="button">Agregar a todos</button></div><div id="lineEditor" class="quote-lines"></div></section><div id="quoteFeedback" class="quote-feedback" role="status" aria-live="polite"></div><div class="quote-form-actions"><button id="saveQuote" class="quote-button quote-button--primary" type="button">Crear cotización</button></div>
      </form>
    </section>
  </main>
  <script>
  (()=>{"use strict";
    const state={data:null,clientMode:"registered",editingId:"",selectedStates:new Set(),selectedMunicipalities:new Set(),selectedCenters:new Set(),selectedConcepts:new Map(),lines:[],dirty:false};
    const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
    const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]));
    const norm=v=>String(v||"").normalize("NFD").replace(/[\u0300-\u036f]/g,"").toUpperCase(), num=v=>Number(String(v??"").replace(/[$,\s]/g,""))||0, pct=v=>{const n=num(v);return n>=0&&n<=1?n*100:n};
    const e={tabs:$$('[data-tab]'),editorTab:$('[data-tab="editor"]'),panels:$$('[data-panel]'),list:$('#quoteList'),search:$('#quoteSearch'),title:$('#editorTitle'),subtitle:$('#editorSubtitle'),company:$('#companySelect'),withoutMunicipalOrder:$('#withoutMunicipalOrder'),withoutStateOrder:$('#withoutStateOrder'),recipient:$('#recipientInput'),date:$('#quoteDate'),signature:$('#signatureSelect'),state:$('#stateSelect'),stateSummary:$('#stateSummary'),stateOptions:$('#stateOptions'),municipality:$('#municipalitySelect'),municipalitySummary:$('#municipalitySummary'),municipalityOptions:$('#municipalityOptions'),centerSearch:$('#centerSearch'),centers:$('#centerList'),visibleCenterCount:$('#visibleCenterCount'),selectAllCenters:$('#selectAllCenters'),clearVisibleCenters:$('#clearVisibleCenters'),externalCenters:$('#externalCenters'),centerCount:$('#centerCount'),conceptSearch:$('#conceptSearch'),concepts:$('#conceptList'),newConcepts:$('#newConceptSection'),editLines:$('#editLinesSection'),lineEditor:$('#lineEditor'),lineCount:$('#lineCount'),bulkConcept:$('#bulkConceptSelect'),bulkQuantity:$('#bulkQuantity'),bulkPrice:$('#bulkPrice'),bulkIva:$('#bulkIva'),addConceptToAll:$('#addConceptToAll'),save:$('#saveQuote'),cancel:$('#cancelEdit'),document:$('#documentLink'),feedback:$('#quoteFeedback')};
    const feedback=(m="",t="")=>{e.feedback.textContent=m;e.feedback.className=`quote-feedback${t?` is-${t}`:""}`}, companyName=c=>c?.nombreComercial||c?.razonSocial||"Empresa sin nombre", centerName=c=>c?(c.nombre||[c.tienda,c.nombreCorto].filter(Boolean).join(" ")||c.id||"Centro"):"";
    function setTab(tab){e.tabs.forEach(b=>b.setAttribute("aria-selected",String(b.dataset.tab===tab)));e.panels.forEach(p=>p.hidden=p.dataset.panel!==tab)}
    function selectedCenterIds(){return state.clientMode==="external"?e.externalCenters.value.split(/\r?\n/).map(v=>v.trim()).filter(Boolean):[...state.selectedCenters]}
    function setClientMode(mode){state.clientMode=mode;$$('[data-client-mode]').forEach(b=>b.setAttribute("aria-pressed",String(b.dataset.clientMode===mode)));$$('[data-registered]').forEach(n=>n.hidden=mode!=="registered");$$('[data-external]').forEach(n=>n.hidden=mode!=="external");renderCenters()}
    function populate(){e.company.innerHTML='<option value="">Seleccionar empresa</option>'+state.data.empresas.map(x=>`<option value="${esc(x.id)}">${esc(companyName(x))}${x.razonSocial&&x.razonSocial!==companyName(x)?` · ${esc(x.razonSocial)}`:""}</option>`).join("");e.signature.innerHTML='<option value="">Seleccionar firma</option>'+state.data.firmas.map(x=>`<option value="${esc(x.id)}">${esc(x.nombre)}${x.puesto?` · ${esc(x.puesto)}`:""}</option>`).join("");e.bulkConcept.innerHTML='<option value="">Seleccionar concepto</option>'+state.data.conceptos.map(x=>`<option value="${esc(x.id)}">${esc(x.nombre||x.codigo)}</option>`).join("");renderConcepts();renderStates();renderMunicipalities();renderCenters();renderQuotes()}
    function filterSummary(selected,items,allLabel){if(!selected.size)return allLabel;const names=items.filter(x=>selected.has(String(x.id))).map(x=>x.nombre);return names.length<=2?names.join(" · "):`${names.length} seleccionados`}
    function renderStates(){const company=e.company.value,ids=new Set(state.data.sucursales.filter(x=>!company||String(x.empresaId)===company).map(x=>String(x.estadoId))),items=state.data.estados.filter(x=>ids.has(String(x.id))).sort((a,b)=>a.nombre.localeCompare(b.nombre,"es-MX"));state.selectedStates=new Set([...state.selectedStates].filter(id=>ids.has(id)));e.stateSummary.textContent=filterSummary(state.selectedStates,items,"Todos los estados");e.stateOptions.innerHTML=items.length?items.map(x=>`<label class="quote-filter-option"><input type="checkbox" value="${esc(x.id)}"${state.selectedStates.has(String(x.id))?" checked":""}><span>${esc(x.nombre)}</span></label>`).join(""):'<div class="quote-empty">No hay estados disponibles.</div>';$$('input[type=checkbox]',e.stateOptions).forEach(input=>input.addEventListener('change',()=>{input.checked?state.selectedStates.add(input.value):state.selectedStates.delete(input.value);state.selectedMunicipalities.clear();state.dirty=true;renderStates();renderMunicipalities();renderCenters()}))}
    function renderQuotes(){const q=norm(e.search.value),rows=state.data.cotizaciones.filter(x=>!q||norm(`${x.cliente} ${x.titulo} ${x.fecha}`).includes(q));e.list.innerHTML=rows.length?rows.map(x=>`<article class="quote-card"><span class="quote-logo">${x.logoUrl?`<img src="${esc(x.logoUrl)}" alt="Logo de ${esc(x.cliente)}" loading="lazy">`:esc((x.cliente||"EG").slice(0,2).toUpperCase())}</span><span class="quote-card-copy"><strong>${esc(x.cliente)}</strong><span>${esc(x.titulo||"Cotización")}</span></span><span class="quote-date">${esc(x.fecha||"Sin fecha")}</span><span class="quote-card-actions"><a class="quote-card-action quote-card-action--view" href="/cotizaciones/cotizacion/${encodeURIComponent(x.id)}/html" target="_blank" rel="noopener">Ver cotización</a><button class="quote-card-action" type="button" data-edit-quote="${esc(x.id)}">Editar</button></span></article>`).join(""):'<div class="quote-empty">No hay cotizaciones que coincidan con la búsqueda.</div>';$$('[data-edit-quote]',e.list).forEach(b=>b.addEventListener('click',()=>loadQuote(b.dataset.editQuote)))}
    function renderMunicipalities(){const company=e.company.value,ids=new Set(state.data.sucursales.filter(x=>(!company||String(x.empresaId)===company)&&(!state.selectedStates.size||state.selectedStates.has(String(x.estadoId)))).map(x=>String(x.municipioId))),items=state.data.municipios.filter(x=>ids.has(String(x.id))).sort((a,b)=>a.nombre.localeCompare(b.nombre,"es-MX"));state.selectedMunicipalities=new Set([...state.selectedMunicipalities].filter(id=>ids.has(id)));e.municipalitySummary.textContent=filterSummary(state.selectedMunicipalities,items,"Todos los municipios");e.municipalityOptions.innerHTML=items.length?items.map(x=>`<label class="quote-filter-option"><input type="checkbox" value="${esc(x.id)}"${state.selectedMunicipalities.has(String(x.id))?" checked":""}><span>${esc(x.nombre)}</span></label>`).join(""):'<div class="quote-empty">No hay municipios disponibles.</div>';$$('input[type=checkbox]',e.municipalityOptions).forEach(input=>input.addEventListener('change',()=>{input.checked?state.selectedMunicipalities.add(input.value):state.selectedMunicipalities.delete(input.value);state.dirty=true;renderMunicipalities();renderCenters()}))}
    function filteredCenters(){if(!state.data||!e.company.value)return[];const company=e.company.value,q=norm(e.centerSearch.value);return state.data.sucursales.filter(x=>String(x.empresaId)===company&&x.activa!==false&&(!e.withoutMunicipalOrder.checked||(x.requierePedidoMunicipal===true&&x.tienePedidoMunicipal!==true))&&(!e.withoutStateOrder.checked||(x.requierePedidoEstatal===true&&x.tienePedidoEstatal!==true))&&(!state.selectedStates.size||state.selectedStates.has(String(x.estadoId)))&&(!state.selectedMunicipalities.size||state.selectedMunicipalities.has(String(x.municipioId)))&&(!q||norm(`${centerName(x)} ${x.municipio?.nombre} ${x.estado?.nombre} ${x.domicilio}`).includes(q)))}
    function renderCenters(){if(!state.data)return;if(state.clientMode==="external"){const n=selectedCenterIds().length;e.centerCount.textContent=`${n} seleccionado${n===1?"":"s"}`;return}if(!e.company.value){e.centers.innerHTML='<div class="quote-empty">Selecciona una empresa para ver sus centros.</div>';e.centerCount.textContent="0 seleccionados";e.visibleCenterCount.textContent="0 sucursales resultantes";e.selectAllCenters.disabled=true;e.clearVisibleCenters.disabled=true;return}const rows=filteredCenters();e.centers.innerHTML=rows.length?rows.map(x=>`<label class="quote-check"><input type="checkbox" value="${esc(x.id)}"${state.selectedCenters.has(String(x.id))?" checked":""}><span><strong>${esc(centerName(x))}</strong><small>${esc([x.municipio?.nombre,x.estado?.nombre,x.domicilio].filter(Boolean).join(" · "))}</small></span></label>`).join(""):'<div class="quote-empty">No hay centros con estos filtros.</div>';$$('input[type=checkbox]',e.centers).forEach(i=>i.addEventListener('change',()=>{i.checked?state.selectedCenters.add(i.value):state.selectedCenters.delete(i.value);state.dirty=true;renderCenters();if(state.editingId)renderLines()}));const visibleSelected=rows.filter(x=>state.selectedCenters.has(String(x.id))).length;e.centerCount.textContent=`${state.selectedCenters.size} seleccionado${state.selectedCenters.size===1?"":"s"}`;e.visibleCenterCount.textContent=`${rows.length} sucursal${rows.length===1?"":"es"} resultante${rows.length===1?"":"s"} · ${visibleSelected} seleccionada${visibleSelected===1?"":"s"}`;e.selectAllCenters.disabled=!rows.length||visibleSelected===rows.length;e.clearVisibleCenters.disabled=!visibleSelected}
    function conceptDefaults(concept){const branchPrice=["PAGO DE DERECHOS ESTATAL","PAGO DE DERECHOS MUNICIPAL"].includes(norm(concept.nombre));return{id:String(concept.id),nombre:concept.nombre||"",cantidad:1,precio:branchPrice?"":num(concept.precioSugerido),iva:pct(concept.iva||.16),precioManual:false,branchPrice}}
    function renderConcepts(){if(!state.data)return;const q=norm(e.conceptSearch.value),rows=state.data.conceptos.filter(x=>!q||norm(`${x.codigo} ${x.nombre} ${x.descripcion}`).includes(q));e.concepts.innerHTML=rows.map(x=>{const saved=state.selectedConcepts.get(String(x.id))||conceptDefaults(x);return `<label class="quote-check"><input type="checkbox" value="${esc(x.id)}"${state.selectedConcepts.has(String(x.id))?" checked":""}><span><strong>${esc(x.nombre||x.codigo)}</strong><small>${esc([x.codigo,x.tipo].filter(Boolean).join(" · "))}</small><span class="quote-concept-controls"><input data-role="qty" type="number" min="0" step="1" value="${esc(saved.cantidad)}" title="Cantidad"><input data-role="price" type="number" min="0" step=".01" value="${esc(saved.precio)}" placeholder="${saved.branchPrice&&!saved.precioManual?"Según sucursal":"Precio"}" title="Precio"><input data-role="iva" type="number" min="0" step=".01" value="${esc(saved.iva)}" title="IVA"></span></span></label>`}).join("");$$('input[type=checkbox]',e.concepts).forEach(input=>input.addEventListener('change',()=>{const concept=state.data.conceptos.find(x=>String(x.id)===input.value);if(input.checked){const card=input.closest('.quote-check'),saved=state.selectedConcepts.get(input.value)||conceptDefaults(concept);state.selectedConcepts.set(input.value,{...saved,cantidad:$('[data-role=qty]',card).value,precio:$('[data-role=price]',card).value,iva:$('[data-role=iva]',card).value})}else state.selectedConcepts.delete(input.value);state.dirty=true}));$$('[data-role]',e.concepts).forEach(control=>control.addEventListener('input',()=>{const card=control.closest('.quote-check'),input=$('input[type=checkbox]',card),concept=state.data.conceptos.find(x=>String(x.id)===input.value),saved=state.selectedConcepts.get(input.value)||conceptDefaults(concept);input.checked=true;state.selectedConcepts.set(input.value,{...saved,cantidad:$('[data-role=qty]',card).value,precio:$('[data-role=price]',card).value,iva:$('[data-role=iva]',card).value,precioManual:control.dataset.role==='price'?true:saved.precioManual});state.dirty=true}))}
    function lineTemplate(line,index){return `<div class="quote-line" data-line-index="${index}"><div class="quote-field"><label>Concepto</label><select data-line="conceptoId"><option value="">Seleccionar</option>${state.data.conceptos.map(x=>`<option value="${esc(x.id)}"${String(x.id)===String(line.conceptoId)?" selected":""}>${esc(x.nombre||x.codigo)}</option>`).join("")}</select></div><div class="quote-field"><label>Cantidad</label><input data-line="cantidad" type="number" min="0" step="1" value="${esc(line.cantidad??1)}"></div><div class="quote-field"><label>Precio</label><input data-line="precio" type="number" min="0" step=".01" value="${esc(line.precio??0)}"></div><div class="quote-field"><label>IVA (%)</label><input data-line="iva" type="number" min="0" max="100" step="1" value="${esc(pct(line.iva??.16))}"></div><button class="quote-remove" type="button" data-remove-line="${index}" aria-label="Eliminar concepto">×</button></div>`}
    function syncLines(){$$('[data-line-index]',e.lineEditor).forEach(row=>{const line=state.lines[Number(row.dataset.lineIndex)];if(line)$$('[data-line]',row).forEach(input=>line[input.dataset.line]=input.value)})}
    function updateBulkConceptDefaults(){const concept=state.data?.conceptos.find(x=>String(x.id)===String(e.bulkConcept.value));if(!concept)return;e.bulkQuantity.value="1";e.bulkPrice.value=String(num(concept.precioSugerido));e.bulkIva.value=String(pct(concept.iva||.16))}
    function addConceptToAllCenters(){syncLines();const centers=selectedCenterIds(),conceptId=e.bulkConcept.value;if(!centers.length){feedback("Selecciona al menos un centro de trabajo.","error");return}if(!conceptId){feedback("Selecciona el concepto que deseas agregar a todos los centros.","error");e.bulkConcept.focus();return}const existing=new Set(state.lines.filter(line=>String(line.conceptoId)===String(conceptId)).map(line=>String(line.centroTrabajoId))),missing=centers.filter(centerId=>!existing.has(String(centerId)));missing.forEach(centerId=>state.lines.push({id:"",centroTrabajoId:centerId,conceptoId:conceptId,cantidad:e.bulkQuantity.value||1,precio:e.bulkPrice.value||0,iva:e.bulkIva.value||0}));if(!missing.length){feedback("Este concepto ya existe en todos los centros seleccionados.");return}state.dirty=true;renderLines();feedback(`Concepto agregado a ${missing.length} centro${missing.length===1?"":"s"}.`,"success")}
    function renderLines(){syncLines();const centers=selectedCenterIds();state.lines=state.lines.filter(line=>centers.includes(String(line.centroTrabajoId)));e.lineCount.textContent=`${state.lines.length} concepto${state.lines.length===1?"":"s"}`;e.lineEditor.innerHTML=centers.map(id=>{const center=state.data.sucursales.find(x=>String(x.id)===String(id)),entries=state.lines.map((line,index)=>({line,index})).filter(x=>String(x.line.centroTrabajoId)===String(id));return `<section class="quote-center-lines"><header><strong>${esc(centerName(center)||id)}</strong><button class="quote-button" type="button" data-add-line="${esc(id)}">Agregar concepto</button></header>${entries.length?entries.map(x=>lineTemplate(x.line,x.index)).join(""):'<div class="quote-empty">Agrega al menos un concepto para este centro.</div>'}</section>`}).join("");$$('[data-add-line]',e.lineEditor).forEach(b=>b.addEventListener('click',()=>{syncLines();state.lines.push({id:"",centroTrabajoId:b.dataset.addLine,conceptoId:"",cantidad:1,precio:0,iva:16});renderLines()}));$$('[data-remove-line]',e.lineEditor).forEach(b=>b.addEventListener('click',()=>{syncLines();state.lines.splice(Number(b.dataset.removeLine),1);renderLines()}));$$('input,select',e.lineEditor).forEach(i=>i.addEventListener('change',()=>{state.dirty=true;syncLines()}))}
    function resetEditor(){state.editingId="";state.selectedStates.clear();state.selectedMunicipalities.clear();state.selectedCenters.clear();state.selectedConcepts.clear();state.lines=[];state.dirty=false;e.editorTab.textContent="Crear cotización";e.company.value="";e.withoutMunicipalOrder.checked=false;e.withoutStateOrder.checked=false;e.recipient.value="";e.date.value=new Date().toISOString().slice(0,10);e.signature.value="";e.state.open=false;e.municipality.open=false;e.externalCenters.value="";e.centerSearch.value="";e.conceptSearch.value="";e.bulkConcept.value="";e.bulkQuantity.value="1";e.bulkPrice.value="0";e.bulkIva.value="16";e.title.textContent="Nueva cotización";e.subtitle.textContent="Configura el cliente, los centros, conceptos y la firma.";e.save.textContent="Crear cotización";e.document.hidden=true;e.newConcepts.hidden=false;e.editLines.hidden=true;setClientMode("registered");renderStates();renderMunicipalities();renderConcepts();feedback()}
    function showSavedQuote(q){state.editingId=q.id;state.lines=q.lineas||[];e.editorTab.textContent="Editar cotización";e.title.textContent="Editar cotización";e.subtitle.textContent="Todos los conceptos están agrupados por centro de trabajo.";e.save.textContent="Guardar cambios";e.document.href=`/cotizaciones/cotizacion/${encodeURIComponent(q.id)}/html`;e.document.hidden=false;e.newConcepts.hidden=true;e.editLines.hidden=false;renderCenters();renderLines();state.dirty=false;const url=new URL(location.href);url.searchParams.set("edit",q.id);history.replaceState({},"",url)}
    async function loadQuote(id){setTab("editor");e.editorTab.textContent="Editar cotización";e.title.textContent="Cargando cotización...";feedback("Consultando todos los conceptos y centros...");try{const r=await fetch(`/cotizaciones/api/cotizaciones/${encodeURIComponent(id)}`),p=await r.json();if(!r.ok)throw new Error(p.error||"No se pudo abrir la cotización.");const q=p.data;state.editingId=q.id;state.lines=q.lineas||[];state.selectedStates.clear();state.selectedMunicipalities.clear();state.selectedCenters=new Set((q.centrosTrabajo||[]).map(String));e.company.value=q.empresaId||"";e.recipient.value=q.destinatario||"";e.date.value=q.fecha||"";e.signature.value=q.proveedorId||"";e.externalCenters.value=q.empresaId?"":q.centrosTrabajo.join("\n");e.title.textContent="Editar cotización";e.subtitle.textContent="Todos los conceptos están agrupados por centro de trabajo.";e.save.textContent="Guardar cambios";e.document.href=`/cotizaciones/cotizacion/${encodeURIComponent(q.id)}/html`;e.document.hidden=false;e.newConcepts.hidden=true;e.editLines.hidden=false;setClientMode(q.empresaId?"registered":"external");renderStates();renderMunicipalities();renderCenters();renderLines();state.dirty=false;feedback();const url=new URL(location.href);url.searchParams.set("edit",q.id);history.replaceState({},"",url)}catch(error){feedback(error.message,"error")}}
    function payload(){const centers=selectedCenterIds();if(!centers.length)throw new Error("Selecciona al menos un centro de trabajo.");const base={empresaId:state.clientMode==="registered"?e.company.value:"",destinatario:state.clientMode==="external"?e.recipient.value.trim():"",fecha:e.date.value,proveedorId:e.signature.value,centrosTrabajo:centers};if(state.editingId){syncLines();return{...base,lineas:state.lines}}return{...base,conceptos:[...state.selectedConcepts.values()]}}
    async function responseJson(r){const text=await r.text();try{return JSON.parse(text)}catch{throw new Error(r.ok?"El servidor devolvió una respuesta inválida.":"El servidor interrumpió la operación. Consulta el estado antes de volver a enviarla.")}}
    async function waitForSave(jobId){for(;;){await new Promise(resolve=>setTimeout(resolve,2000));const r=await fetch(`/cotizaciones/api/cotizaciones-jobs/${encodeURIComponent(jobId)}`),p=await responseJson(r);if(!r.ok||p.status==='failed')throw new Error(p.error||"No se pudo guardar la cotización.");if(p.status==='completed')return p.data;feedback("Guardando centros y conceptos en AppSheet...")}}
    async function save(){try{e.save.disabled=true;feedback("Creando la cotización y sus conceptos...");const url=state.editingId?`/cotizaciones/api/cotizaciones/${encodeURIComponent(state.editingId)}`:'/cotizaciones/api/cotizaciones',r=await fetch(url,{method:state.editingId?'PUT':'POST',headers:{'Content-Type':'application/json','X-Quote-Async':'1'},body:JSON.stringify(payload())}),p=await responseJson(r);if(!r.ok)throw new Error(p.error||"No se pudo guardar la cotización.");const saved=p.processing?await waitForSave(p.jobId):p.data;if(!saved?.id)throw new Error("El servidor no devolvió la cotización terminada.");showSavedQuote(saved);feedback(`Cotización guardada con ${saved.conceptos} conceptos.`,"success")}catch(error){feedback(error.message,"error")}finally{e.save.disabled=false}}
    async function loadWorkspace(){const r=await fetch('/cotizaciones/api/workspace'),p=await r.json();if(!r.ok)throw new Error(p.error||"No se pudo cargar el módulo.");state.data=p.data;populate()}
    e.tabs.forEach(b=>b.addEventListener('click',()=>{if(b.dataset.tab==='editor')resetEditor();if(b.dataset.tab==='list')void loadWorkspace().catch(error=>feedback(error.message,"error"));setTab(b.dataset.tab);const url=new URL(location.href);url.searchParams.delete('edit');history.replaceState({},"",url)}));$$('[data-client-mode]').forEach(b=>b.addEventListener('click',()=>{setClientMode(b.dataset.clientMode);state.dirty=true}));e.search.addEventListener('input',renderQuotes);e.company.addEventListener('change',()=>{state.selectedStates.clear();state.selectedMunicipalities.clear();state.selectedCenters.clear();renderStates();renderMunicipalities();renderCenters();state.dirty=true});[e.withoutMunicipalOrder,e.withoutStateOrder].forEach(input=>input.addEventListener('change',()=>{renderCenters();state.dirty=true}));e.centerSearch.addEventListener('input',renderCenters);e.selectAllCenters.addEventListener('click',()=>{filteredCenters().forEach(center=>state.selectedCenters.add(String(center.id)));state.dirty=true;renderCenters();if(state.editingId)renderLines()});e.clearVisibleCenters.addEventListener('click',()=>{filteredCenters().forEach(center=>state.selectedCenters.delete(String(center.id)));state.dirty=true;renderCenters();if(state.editingId)renderLines()});e.externalCenters.addEventListener('input',()=>{renderCenters();if(state.editingId)renderLines()});e.conceptSearch.addEventListener('input',renderConcepts);e.bulkConcept.addEventListener('change',updateBulkConceptDefaults);e.addConceptToAll.addEventListener('click',addConceptToAllCenters);e.save.addEventListener('click',save);e.cancel.addEventListener('click',()=>{resetEditor();setTab('list');const url=new URL(location.href);url.searchParams.delete('edit');history.replaceState({},"",url)});loadWorkspace().then(()=>{const id=new URLSearchParams(location.search).get('edit');if(id)loadQuote(id)}).catch(error=>e.list.innerHTML=`<div class="quote-empty">${esc(error.message)}</div>`);
  })();
  </script>
