<style>
  .quote-order-filters{grid-column:span 2;display:flex;align-items:center;gap:9px;flex-wrap:wrap}.quote-order-filter{min-height:42px;display:flex;align-items:center;gap:9px;padding:9px 12px;border:1px solid var(--q-line);border-radius:11px;background:#fff;color:var(--q-ink);cursor:pointer;font-size:.72rem;font-weight:800}.quote-order-filter:has(input:checked){border-color:var(--q-teal);background:rgba(15,89,97,.07);color:var(--q-teal)}.quote-order-filter input{width:17px;height:17px;margin:0;accent-color:var(--q-teal)}@media(max-width:650px){.quote-order-filters{grid-column:auto;display:grid}}
