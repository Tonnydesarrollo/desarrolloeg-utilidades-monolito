or:pointer;font-size:.72rem;font-weight:800}.quote-client-mode button[aria-pressed=true]{color:#fff;background:var(--q-teal)}.quote-centers,.quote-concepts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;max-height:330px;overflow:auto;padding:2px}.quote-check{display:grid;grid-template-columns:auto 1fr;gap:10px;align-items:start;padding:12px;border:1px solid var(--q-line);border-radius:13px;background:#fff;cursor:pointer}.quote-check:has(input:checked){border-color:var(--q-teal);background:rgba(15,89,97,.055)}.quote-check>input{width:17px;height:17px;margin:2px 0 0;accent-color:var(--q-teal)}.quote-check strong{display:block;font-size:.75rem}.quote-check small{display:block;margin-top:3px;color:var(--q-muted);font-size:.65rem;line-height:1.35}.quote-concept-controls{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-top:9px}.quote-concept-controls input{min-width:0;width:100%;padding:7px;border:1px solid var(--q-line);border-radius:8px;font-size:.68rem}.quote-lines{display:grid;gap:12px}.quote-center-lines{border:1px solid var(--q-line);border-radius:15px;background:#fff;overflow:hidden}.quote-center-lines>header{display:flex;justify-content:space-between;align-items:center;padding:13px 15px;background:#edf3f5}.quote-center-lines>header strong{font-size:.78rem}.quote-line{display:grid;grid-template-columns:minmax(180px,2fr) repeat(3,minmax(90px,.7fr)) auto;gap:8px;align-items:end;padding:11px 14px;border-top:1px solid var(--q-line)}.quote-line .quote-field input,.quote-line .quote-field select{min-height:40px;padding:8px 10px;font-size:.75rem}.quote-remove{width:40px;height:40px;border:1px solid rgba(189,48,41,.22);border-radius:10px;color:var(--q-red);background:#fff2f1;cursor:pointer;font-weight:900}.quote-feedback{min-height:22px;color:var(--q-muted);font-size:.75rem}.quote-feedback.is-error{color:#a42620}.quote-feedback.is-success{color:#08725f}@media(max-width:1000px){.quote-list,.quote-centers,.quote-concepts{grid-template-columns:repeat(2,minmax(0,1fr))}.quote-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.quote-line{grid-template-columns:1fr 1fr}.quote-remove{width:100%}}@media(max-width:650px){.quote-shell{width:min(100% - 20px,1500px);padding-top:18px}.quote-hero{padding:25px 20px}.quote-tabs,.quote-list,.quote-centers,.quote-concepts,.quote-grid{grid-template-columns:1fr}.quote-span-2{grid-column:auto}.quote-panel-head,.quote-editor-head{align-items:stretch;flex-direction:column}.quote-form{padding:15px}.quote-section{padding:14px}.quote-line{grid-template-columns:1fr}.quote-card-actions{grid-column:1/-1}.quote-card-action{flex:1}}
  </style>
  <style>
    body.portal-shell a.quote-button--dark,body.portal-shell a.quote-card-action--view{justify-content:center;color:#fff;background:var(--q-ink);border-color:var(--q-ink)}body.portal-shell a.quote-button--dark:hover,body.portal-shell a.quote-card-action--view:hover{color:#fff;background:#1b4057;border-color:#1b4057;box-shadow:0 9px 20px rgba(18,43,60,.18)}body.portal-shell a.quote-button--dark:focus-visible,body.portal-shell a.quote-card-action--view:focus-visible{color:#fff;outline:3px solid rgba(15,89,97,.25);outline-offset:3px}.quote-bulk-add{display:grid;grid-template-columns:minmax(230px,2fr) repeat(3,minmax(90px,.7fr)) auto;gap:9px;align-items:end;margin-bottom:15px;padding:14px;border:1px solid rgba(15,89,97,.2);border-radius:15px;background:linear-gradient(120deg,rgba(15,89,97,.07),rgba(255,255,255,.96))}.quote-bulk-add .quote-button{white-space:nowrap}.quote-form-actions{display:flex;justify-content:flex-end;align-items:center;gap:12px;padding-top:2px}.quote-form-actions .quote-button--primary{min-width:min(100%,240px);min-height:52px;padding:0 24px;box-shadow:0 12px 26px rgba(189,48,41,.2)}@media(max-width:1000px){.quote-bulk-add{grid-template-columns:1fr 1fr}}@media(max-width:650px){.quote-bulk-add{grid-template-columns:1fr}.quote-form-actions{display:grid}.quote-form-actions .quote-button--primary{width:100%}}
  </style>
  <style>
    .quote-multiselect{position:relative}.quote-multiselect summary{min-height:46px;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 13px;border:1px solid var(--q-line);border-radius:12px;color:var(--q-ink);background:rgba(249,251,252,.92);cursor:pointer;list-style:none;font-size:.78rem;font-weight:750}.quote-multiselect summary::-webkit-details-marker{display:none}.quote-multiselect summary:after{content:"+";color:var(--q-teal);font-size:1rem;font-weight:900}.quote-multiselect[open] summary{border-color:var(--q-teal);border-radius:12px 12px 0 0;box-shadow:0 0 0 3px rgba(15,89,97,.1)}.quote-multiselect[open] summary:after{content:"-"}.quote-multiselect-options{position:absolute;z-index:20;top:calc(100% - 1px);left:0;right:0;max-height:250px;overflow:auto;padding:7px;border:1px solid var(--q-teal);border-radius:0 0 12px 12px;background:#fff;box-shadow:0 18px 35px rgba(18,43,60,.16)}.quote-multiselect-options .quote-filter-option{width:100%;display:flex;align-items:center;gap:9px;padding:9px;border-radius:8px;cursor:pointer;font-size:.74rem}.quote-filter-option:hover{background:#edf4f5}.quote-filter-option input{width:16px;height:16px;margin:0;accent-color:var(--q-teal)}.quote-center-toolbar{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}.quote-center-toolbar-copy{color:var(--q-muted);font-size:.7rem}.quote-center-toolbar-actions{display:flex;gap:8px;flex-wrap:wrap}.quote-center-toolbar .quote-button{min-height:38px;font-size:.7rem}.quote-button--select-all{color:#fff;border-color:var(--q-teal);background:var(--q-teal)}@media(max-width:650px){.quote-center-toolbar,.quote-center-toolbar-actions{display:grid;grid-template-columns:1fr;width:100%}.quote-center-toolbar .quote-button{width:100%}}
