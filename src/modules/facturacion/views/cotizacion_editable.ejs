  <style>
    :root{--q-ink:#122b3c;--q-muted:#627384;--q-red:#bd3029;--q-teal:#0f5961;--q-line:rgba(27,54,72,.13);--q-paper:rgba(255,255,255,.9)}*{box-sizing:border-box}body{margin:0;color:var(--q-ink);background:radial-gradient(circle at 8% 4%,rgba(189,48,41,.09),transparent 28rem),linear-gradient(135deg,#f8f5f2 0%,#edf3f6 58%,#f9faf9 100%)}button,input,select,textarea{font:inherit}.quote-shell{width:min(1500px,calc(100% - 36px));margin:0 auto;padding:34px 0 90px}.quote-hero{position:relative;overflow:hidden;padding:34px;border:1px solid rgba(255,255,255,.8);border-radius:28px;background:linear-gradient(125deg,rgba(255,255,255,.93),rgba(255,255,255,.67));box-shadow:0 24px 70px rgba(24,52,70,.1);backdrop-filter:blur(22px)}.quote-hero:after{content:"";position:absolute;right:-60px;top:-90px;width:330px;height:240px;border-radius:50%;background:radial-gradient(circle,rgba(15,89,97,.17),transparent 68%)}.quote-eyebrow,.quote-label{color:var(--q-red);font:800 .68rem/1.2 "Avenir Next","Trebuchet MS",sans-serif;letter-spacing:.14em;text-transform:uppercase}.quote-hero h1{margin:10px 0 7px;font:700 clamp(2rem,5vw,4rem)/.96 Georgia,serif}.quote-hero p{max-width:720px;margin:0;color:var(--q-muted);line-height:1.55}.quote-tabs{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin:18px 0;padding:7px;border:1px solid var(--q-line);border-radius:18px;background:rgba(255,255,255,.65)}.quote-tab{min-height:50px;border:0;border-radius:13px;color:var(--q-muted);background:transparent;cursor:pointer;font-weight:800}.quote-tab[aria-selected=true]{color:#fff;background:var(--q-ink);box-shadow:0 10px 24px rgba(18,43,60,.18)}[hidden]{display:none!important}.quote-panel,.quote-editor{border:1px solid var(--q-line);border-radius:24px;background:var(--q-paper);box-shadow:0 18px 45px rgba(24,52,70,.07)}.quote-panel{padding:22px}.quote-panel-head{display:flex;justify-content:space-between;align-items:end;gap:18px;margin-bottom:18px}.quote-panel-head h2,.quote-editor h2{margin:0;font:700 1.55rem/1.1 Georgia,serif}.quote-panel-head p{margin:5px 0 0;color:var(--q-muted);font-size:.82rem}.quote-search{width:min(420px,100%)}.quote-field{display:grid;gap:7px;min-width:0}.quote-field label{color:var(--q-muted);font:800 .63rem/1.2 "Avenir Next","Trebuchet MS",sans-serif;letter-spacing:.1em;text-transform:uppercase}.quote-field input,.quote-field select,.quote-field textarea{width:100%;min-height:46px;padding:11px 13px;border:1px solid var(--q-line);border-radius:12px;color:var(--q-ink);background:rgba(249,251,252,.92);outline:none}.quote-field textarea{min-height:105px;resize:vertical}.quote-field input:focus,.quote-field select:focus,.quote-field textarea:focus{border-color:var(--q-teal);box-shadow:0 0 0 3px rgba(15,89,97,.1)}.quote-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.quote-card{display:grid;grid-template-columns:54px 1fr auto;gap:13px;align-items:center;min-width:0;padding:15px;border:1px solid var(--q-line);border-radius:17px;color:inherit;background:#fff;cursor:pointer;text-align:left;transition:.16s ease}.quote-card:hover{transform:translateY(-2px);border-color:rgba(15,89,97,.35);box-shadow:0 14px 28px rgba(18,43,60,.09)}.quote-logo{width:54px;height:54px;display:grid;place-items:center;overflow:hidden;border:1px solid var(--q-line);border-radius:14px;color:var(--q-teal);background:#f2f6f7;font-weight:900}.quote-logo img{width:100%;height:100%;object-fit:contain}.quote-card-copy{min-width:0}.quote-card-copy strong,.quote-card-copy span{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.quote-card-copy strong{font-size:.83rem}.quote-card-copy span{margin-top:4px;color:var(--q-muted);font-size:.7rem}.quote-date{color:var(--q-red);font-size:.67rem;font-weight:800}.quote-empty,.quote-loading{grid-column:1/-1;padding:50px 20px;border:1px dashed var(--q-line);border-radius:18px;color:var(--q-muted);text-align:center}.quote-editor{overflow:hidden}.quote-editor-head{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:22px 24px;border-bottom:1px solid var(--q-line);background:linear-gradient(115deg,rgba(255,255,255,.98),rgba(239,245,246,.75))}.quote-editor-head p{margin:5px 0 0;color:var(--q-muted);font-size:.77rem}.quote-actions{display:flex;flex-wrap:wrap;gap:8px}.quote-button{min-height:43px;padding:0 15px;border:1px solid var(--q-line);border-radius:12px;color:var(--q-ink);background:#fff;cursor:pointer;font-weight:800}.quote-button--primary{color:#fff;border-color:var(--q-red);background:var(--q-red)}.quote-button--dark{color:#fff;border-color:var(--q-ink);background:var(--q-ink);text-decoration:none;display:inline-flex;align-items:center}.quote-button:disabled{opacity:.55;cursor:wait}.quote-form{display:grid;gap:18px;padding:24px}.quote-section{padding:19px;border:1px solid var(--q-line);border-radius:18px;background:rgba(248,250,251,.75)}.quote-section-title{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:16px}.quote-section-title h3{margin:0;font-size:.86rem;letter-spacing:.08em;text-transform:uppercase}.quote-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px}.quote-span-2{grid-column:span 2}.quote-client-mode{display:inline-grid;grid-template-columns:1fr 1fr;gap:5px;padding:5px;border:1px solid var(--q-line);border-radius:12px;background:#fff}.quote-client-mode button{min-height:35px;padding:0 12px;border:0;border-radius:8px;color:var(--q-muted);background:transparent;cursor:pointer;font-size:.72rem;font-weight:800}.quote-client-mode button[aria-pressed=true]{color:#fff;background:var(--q-teal)}.quote-centers,.quote-concepts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;max-height:330px;overflow:auto;padding:2px}.quote-check{display:grid;grid-template-columns:auto 1fr;gap:10px;align-items:start;padding:12px;border:1px solid var(--q-line);border-radius:13px;background:#fff;cursor:pointer}.quote-check:has(input:checked){border-color:var(--q-teal);background:rgba(15,89,97,.055)}.quote-check>input{width:17px;height:17px;margin:2px 0 0;accent-color:var(--q-teal)}.quote-check strong{display:block;font-size:.75rem}.quote-check small{display:block;margin-top:3px;color:var(--q-muted);font-size:.65rem;line-height:1.35}.quote-concept-controls{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-top:9px}.quote-concept-controls input{min-width:0;width:100%;padding:7px;border:1px solid var(--q-line);border-radius:8px;font-size:.68rem}.quote-lines{display:grid;gap:12px}.quote-center-lines{border:1px solid var(--q-line);border-radius:15px;background:#fff;overflow:hidden}.quote-center-lines>header{display:flex;justify-content:space-between;align-items:center;padding:13px 15px;background:#edf3f5}.quote-center-lines>header strong{font-size:.78rem}.quote-line{display:grid;grid-template-columns:minmax(180px,2fr) repeat(3,minmax(90px,.7fr)) auto;gap:8px;align-items:end;padding:11px 14px;border-top:1px solid var(--q-line)}.quote-line .quote-field input,.quote-line .quote-field select{min-height:40px;padding:8px 10px;font-size:.75rem}.quote-remove{width:40px;height:40px;border:1px solid rgba(189,48,41,.22);border-radius:10px;color:var(--q-red);background:#fff2f1;cursor:pointer;font-weight:900}.quote-feedback{min-height:22px;color:var(--q-muted);font-size:.75rem}.quote-feedback.is-error{color:#a42620}.quote-feedback.is-success{color:#08725f}@media(max-width:1000px){.quote-list,.quote-centers,.quote-concepts{grid-template-columns:repeat(2,minmax(0,1fr))}.quote-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.quote-line{grid-template-columns:1fr 1fr}.quote-remove{width:100%}}@media(max-width:650px){.quote-shell{width:min(100% - 20px,1500px);padding-top:18px}.quote-hero{padding:25px 20px}.quote-tabs,.quote-list,.quote-centers,.quote-concepts,.quote-grid{grid-template-columns:1fr}.quote-span-2{grid-column:auto}.quote-panel-head,.quote-editor-head{align-items:stretch;flex-direction:column}.quote-form{padding:15px}.quote-section{padding:14px}.quote-line{grid-template-columns:1fr}}
  </style>
</head>
<body class="portal-shell portal-cotizaciones portal-facturacion">
  <a class="skip-link" href="#cotizaciones-main">Saltar al contenido principal</a>
  <main id="cotizaciones-main" class="quote-shell">
    <header class="quote-hero"><div class="quote-eyebrow">Comercial</div><h1>Cotizaciones</h1><p>Consulta, crea y actualiza cotizaciones por empresa y centro de trabajo desde una sola vista.</p></header>
    <nav class="quote-tabs" aria-label="Vistas de cotizaciones" role="tablist"><button class="quote-tab" type="button" role="tab" data-tab="list" aria-selected="true">Consultar cotizaciones</button><button class="quote-tab" type="button" role="tab" data-tab="editor" aria-selected="false">Crear cotización</button></nav>
    <section class="quote-panel" data-panel="list"><div class="quote-panel-head"><div><h2>Cotizaciones guardadas</h2><p>Selecciona una tarjeta para consultar y editar todos sus centros y conceptos.</p></div><div class="quote-field quote-search"><label for="quoteSearch">Buscar</label><input id="quoteSearch" type="search" placeholder="Empresa, título o fecha"></div></div><div id="quoteList" class="quote-list"><div class="quote-loading">Cargando cotizaciones...</div></div></section>
    <section class="quote-editor" data-panel="editor" hidden>
      <header class="quote-editor-head"><div><h2 id="editorTitle">Nueva cotización</h2><p id="editorSubtitle">Configura el cliente, los centros, conceptos y la firma.</p></div><div class="quote-actions"><a id="documentLink" class="quote-button quote-button--dark" href="#" target="_blank" hidden>Ver documento</a><button id="cancelEdit" class="quote-button" type="button">Cancelar</button><button id="saveQuote" class="quote-button quote-button--primary" type="button">Crear cotización</button></div></header>
      <form id="quoteForm" class="quote-form" novalidate>
        <section class="quote-section"><div class="quote-section-title"><h3>1. Cliente y firma</h3><div class="quote-client-mode"><button type="button" data-client-mode="registered" aria-pressed="true">Empresa registrada</button><button type="button" data-client-mode="external" aria-pressed="false">No registrada</button></div></div><div class="quote-grid"><div class="quote-field quote-span-2" data-registered><label for="companySelect">Empresa</label><select id="companySelect"><option value="">Seleccionar empresa</option></select></div><div class="quote-field quote-span-2" data-external hidden><label for="recipientInput">Cotización dirigida a</label><input id="recipientInput" placeholder="Nombre de la persona o empresa"></div><div class="quote-field"><label for="quoteDate">Fecha</label><input id="quoteDate" type="date"></div><div class="quote-field"><label for="signatureSelect">Quién firma</label><select id="signatureSelect"><option value="">Seleccionar firma</option></select></div></div></section>
        <section class="quote-section"><div class="quote-section-title"><h3>2. Centros de trabajo</h3><span id="centerCount" class="quote-label">0 seleccionados</span></div><div data-registered><div class="quote-grid" style="margin-bottom:13px"><div class="quote-field"><label for="stateSelect">Estado</label><select id="stateSelect"><option value="">Todos los estados</option></select></div><div class="quote-field"><label for="municipalitySelect">Municipio</label><select id="municipalitySelect"><option value="">Todos los municipios</option></select></div><div class="quote-field quote-span-2"><label for="centerSearch">Buscar centro</label><input id="centerSearch" type="search" placeholder="Número, nombre o dirección"></div></div><div id="centerList" class="quote-centers"><div class="quote-empty">Selecciona una empresa para ver sus centros.</div></div></div><div class="quote-field" data-external hidden><label for="externalCenters">Centros de trabajo, uno por línea</label><textarea id="externalCenters" placeholder="Centro de trabajo norte&#10;Centro de trabajo sur"></textarea></div></section>
        <section class="quote-section" id="newConceptSection"><div class="quote-section-title"><h3>3. Conceptos</h3><span class="quote-label">Se aplicarán a todos los centros</span></div><div class="quote-field" style="margin-bottom:13px"><label for="conceptSearch">Buscar concepto</label><input id="conceptSearch" type="search" placeholder="Producto, servicio o código"></div><div id="conceptList" class="quote-concepts"></div></section>
        <section class="quote-section" id="editLinesSection" hidden><div class="quote-section-title"><h3>3. Conceptos por centro de trabajo</h3><span id="lineCount" class="quote-label"></span></div><div id="lineEditor" class="quote-lines"></div></section><div id="quoteFeedback" class="quote-feedback" role="status" aria-live="polite"></div>
      </form>
    </section>
  </main>
  <script>
  (()=>{"use strict";
    const state={data:null,clientMode:"registered",editingId:"",selectedCenters:new Set(),lines:[],dirty:false};
    const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
    const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]));
    const norm=v=>String(v||"").normalize("NFD").replace(/[\u0300-\u036f]/g,"").toUpperCase(), num=v=>Number(String(v??"").replace(/[$,\s]/g,""))||0;
    const e={tabs:$$('[data-tab]'),panels:$$('[data-panel]'),list:$('#quoteList'),search:$('#quoteSearch'),title:$('#editorTitle'),subtitle:$('#editorSubtitle'),company:$('#companySelect'),recipient:$('#recipientInput'),date:$('#quoteDate'),signature:$('#signatureSelect'),state:$('#stateSelect'),municipality:$('#municipalitySelect'),centerSearch:$('#centerSearch'),centers:$('#centerList'),externalCenters:$('#externalCenters'),centerCount:$('#centerCount'),conceptSearch:$('#conceptSearch'),concepts:$('#conceptList'),newConcepts:$('#newConceptSection'),editLines:$('#editLinesSection'),lineEditor:$('#lineEditor'),lineCount:$('#lineCount'),save:$('#saveQuote'),cancel:$('#cancelEdit'),document:$('#documentLink'),feedback:$('#quoteFeedback')};
    const feedback=(m="",t="")=>{e.feedback.textContent=m;e.feedback.className=`quote-feedback${t?` is-${t}`:""}`}, companyName=c=>c?.nombreComercial||c?.razonSocial||"Empresa sin nombre", centerName=c=>c?(c.nombre||[c.tienda,c.nombreCorto].filter(Boolean).join(" ")||c.id||"Centro"):"";
    function setTab(tab){e.tabs.forEach(b=>b.setAttribute("aria-selected",String(b.dataset.tab===tab)));e.panels.forEach(p=>p.hidden=p.dataset.panel!==tab)}
    function selectedCenterIds(){return state.clientMode==="external"?e.externalCenters.value.split(/\r?\n/).map(v=>v.trim()).filter(Boolean):[...state.selectedCenters]}
    function setClientMode(mode){state.clientMode=mode;$$('[data-client-mode]').forEach(b=>b.setAttribute("aria-pressed",String(b.dataset.clientMode===mode)));$$('[data-registered]').forEach(n=>n.hidden=mode!=="registered");$$('[data-external]').forEach(n=>n.hidden=mode!=="external");renderCenters()}
    function populate(){e.company.innerHTML='<option value="">Seleccionar empresa</option>'+state.data.empresas.map(x=>`<option value="${esc(x.id)}">${esc(companyName(x))}${x.razonSocial&&x.razonSocial!==companyName(x)?` · ${esc(x.razonSocial)}`:""}</option>`).join("");e.signature.innerHTML='<option value="">Seleccionar firma</option>'+state.data.firmas.map(x=>`<option value="${esc(x.id)}">${esc(x.nombre)}${x.puesto?` · ${esc(x.puesto)}`:""}</option>`).join("");renderConcepts();renderStates();renderMunicipalities();renderCenters();renderQuotes()}
    function renderStates(){const company=e.company.value,current=e.state.value,ids=new Set(state.data.sucursales.filter(x=>!company||String(x.empresaId)===company).map(x=>String(x.estadoId)));e.state.innerHTML='<option value="">Todos los estados</option>'+state.data.estados.filter(x=>ids.has(String(x.id))).sort((a,b)=>a.nombre.localeCompare(b.nombre,"es-MX")).map(x=>`<option value="${esc(x.id)}">${esc(x.nombre)}</option>`).join("");if(ids.has(current))e.state.value=current}
    function renderQuotes(){const q=norm(e.search.value),rows=state.data.cotizaciones.filter(x=>!q||norm(`${x.cliente} ${x.titulo} ${x.fecha}`).includes(q));e.list.innerHTML=rows.length?rows.map(x=>`<button class="quote-card" type="button" data-quote-id="${esc(x.id)}"><span class="quote-logo">${x.logoUrl?`<img src="${esc(x.logoUrl)}" alt="Logo de ${esc(x.cliente)}" loading="lazy">`:esc((x.cliente||"EG").slice(0,2).toUpperCase())}</span><span class="quote-card-copy"><strong>${esc(x.cliente)}</strong><span>${esc(x.titulo||"Cotización")}</span></span><span class="quote-date">${esc(x.fecha||"Sin fecha")}</span></button>`).join(""):'<div class="quote-empty">No hay cotizaciones que coincidan con la búsqueda.</div>';$$('[data-quote-id]',e.list).forEach(b=>b.addEventListener('click',()=>loadQuote(b.dataset.quoteId)))}
    function renderMunicipalities(){const company=e.company.value,st=e.state.value,ids=new Set(state.data.sucursales.filter(x=>(!company||String(x.empresaId)===company)&&(!st||String(x.estadoId)===st)).map(x=>String(x.municipioId))),current=e.municipality.value;e.municipality.innerHTML='<option value="">Todos los municipios</option>'+state.data.municipios.filter(x=>ids.has(String(x.id))).sort((a,b)=>a.nombre.localeCompare(b.nombre,"es-MX")).map(x=>`<option value="${esc(x.id)}">${esc(x.nombre)}</option>`).join("");if(ids.has(current))e.municipality.value=current}
    function renderCenters(){if(!state.data)return;if(state.clientMode==="external"){const n=selectedCenterIds().length;e.centerCount.textContent=`${n} seleccionado${n===1?"":"s"}`;return}const company=e.company.value,st=e.state.value,mun=e.municipality.value,q=norm(e.centerSearch.value);if(!company){e.centers.innerHTML='<div class="quote-empty">Selecciona una empresa para ver sus centros.</div>';e.centerCount.textContent="0 seleccionados";return}const rows=state.data.sucursales.filter(x=>String(x.empresaId)===company&&(!st||String(x.estadoId)===st)&&(!mun||String(x.municipioId)===mun)&&(!q||norm(`${centerName(x)} ${x.domicilio}`).includes(q)));e.centers.innerHTML=rows.length?rows.map(x=>`<label class="quote-check"><input type="checkbox" value="${esc(x.id)}"${state.selectedCenters.has(String(x.id))?" checked":""}><span><strong>${esc(centerName(x))}</strong><small>${esc([x.municipio?.nombre,x.estado?.nombre,x.domicilio].filter(Boolean).join(" · "))}</small></span></label>`).join(""):'<div class="quote-empty">No hay centros con estos filtros.</div>';$$('input[type=checkbox]',e.centers).forEach(i=>i.addEventListener('change',()=>{i.checked?state.selectedCenters.add(i.value):state.selectedCenters.delete(i.value);state.dirty=true;renderCenters();if(state.editingId)renderLines()}));e.centerCount.textContent=`${state.selectedCenters.size} seleccionado${state.selectedCenters.size===1?"":"s"}`}
    function renderConcepts(){if(!state.data)return;const q=norm(e.conceptSearch.value),rows=state.data.conceptos.filter(x=>!q||norm(`${x.codigo} ${x.nombre} ${x.descripcion}`).includes(q));e.concepts.innerHTML=rows.map(x=>`<label class="quote-check"><input type="checkbox" value="${esc(x.id)}"><span><strong>${esc(x.nombre||x.codigo)}</strong><small>${esc([x.codigo,x.tipo].filter(Boolean).join(" · "))}</small><span class="quote-concept-controls"><input data-role="qty" type="number" min="0" step="1" value="1" title="Cantidad"><input data-role="price" type="number" min="0" step=".01" value="${esc(num(x.precioSugerido))}" title="Precio"><input data-role="iva" type="number" min="0" step=".01" value="${esc(Number(x.iva)||.16)}" title="IVA"></span></span></label>`).join("")}
    function lineTemplate(line,index){return `<div class="quote-line" data-line-index="${index}"><div class="quote-field"><label>Concepto</label><select data-line="conceptoId"><option value="">Seleccionar</option>${state.data.conceptos.map(x=>`<option value="${esc(x.id)}"${String(x.id)===String(line.conceptoId)?" selected":""}>${esc(x.nombre||x.codigo)}</option>`).join("")}</select></div><div class="quote-field"><label>Cantidad</label><input data-line="cantidad" type="number" min="0" step="1" value="${esc(line.cantidad??1)}"></div><div class="quote-field"><label>Precio</label><input data-line="precio" type="number" min="0" step=".01" value="${esc(line.precio??0)}"></div><div class="quote-field"><label>IVA</label><input data-line="iva" type="number" min="0" step=".01" value="${esc(line.iva??.16)}"></div><button class="quote-remove" type="button" data-remove-line="${index}" aria-label="Eliminar concepto">×</button></div>`}
    function syncLines(){$$('[data-line-index]',e.lineEditor).forEach(row=>{const line=state.lines[Number(row.dataset.lineIndex)];if(line)$$('[data-line]',row).forEach(input=>line[input.dataset.line]=input.value)})}
    function renderLines(){syncLines();const centers=selectedCenterIds();state.lines=state.lines.filter(line=>centers.includes(String(line.centroTrabajoId)));e.lineCount.textContent=`${state.lines.length} concepto${state.lines.length===1?"":"s"}`;e.lineEditor.innerHTML=centers.map(id=>{const center=state.data.sucursales.find(x=>String(x.id)===String(id)),entries=state.lines.map((line,index)=>({line,index})).filter(x=>String(x.line.centroTrabajoId)===String(id));return `<section class="quote-center-lines"><header><strong>${esc(centerName(center)||id)}</strong><button class="quote-button" type="button" data-add-line="${esc(id)}">Agregar concepto</button></header>${entries.length?entries.map(x=>lineTemplate(x.line,x.index)).join(""):'<div class="quote-empty">Agrega al menos un concepto para este centro.</div>'}</section>`}).join("");$$('[data-add-line]',e.lineEditor).forEach(b=>b.addEventListener('click',()=>{syncLines();state.lines.push({id:"",centroTrabajoId:b.dataset.addLine,conceptoId:"",cantidad:1,precio:0,iva:.16});renderLines()}));$$('[data-remove-line]',e.lineEditor).forEach(b=>b.addEventListener('click',()=>{syncLines();state.lines.splice(Number(b.dataset.removeLine),1);renderLines()}));$$('input,select',e.lineEditor).forEach(i=>i.addEventListener('change',()=>{state.dirty=true;syncLines()}))}
    function resetEditor(){state.editingId="";state.selectedCenters.clear();state.lines=[];state.dirty=false;e.company.value="";e.recipient.value="";e.date.value=new Date().toISOString().slice(0,10);e.signature.value="";e.state.value="";e.municipality.value="";e.externalCenters.value="";e.centerSearch.value="";e.title.textContent="Nueva cotización";e.subtitle.textContent="Configura el cliente, los centros, conceptos y la firma.";e.save.textContent="Crear cotización";e.document.hidden=true;e.newConcepts.hidden=false;e.editLines.hidden=true;setClientMode("registered");renderStates();renderMunicipalities();renderConcepts();feedback()}
    async function loadQuote(id){setTab("editor");e.title.textContent="Cargando cotización...";feedback("Consultando todos los conceptos y centros...");try{const r=await fetch(`/cotizaciones/api/cotizaciones/${encodeURIComponent(id)}`),p=await r.json();if(!r.ok)throw new Error(p.error||"No se pudo abrir la cotización.");const q=p.data;state.editingId=q.id;state.lines=q.lineas||[];state.selectedCenters=new Set((q.centrosTrabajo||[]).map(String));e.company.value=q.empresaId||"";e.recipient.value=q.destinatario||"";e.date.value=q.fecha||"";e.signature.value=q.proveedorId||"";e.externalCenters.value=q.empresaId?"":q.centrosTrabajo.join("\n");e.title.textContent="Editar cotización";e.subtitle.textContent="Todos los conceptos están agrupados por centro de trabajo.";e.save.textContent="Guardar cambios";e.document.href=`/cotizaciones/cotizacion/${encodeURIComponent(q.id)}/html`;e.document.hidden=false;e.newConcepts.hidden=true;e.editLines.hidden=false;setClientMode(q.empresaId?"registered":"external");renderStates();renderMunicipalities();renderCenters();renderLines();state.dirty=false;feedback();const url=new URL(location.href);url.searchParams.set("edit",q.id);history.replaceState({},"",url)}catch(error){feedback(error.message,"error")}}
    function payload(){const centers=selectedCenterIds();if(!centers.length)throw new Error("Selecciona al menos un centro de trabajo.");const base={empresaId:state.clientMode==="registered"?e.company.value:"",destinatario:state.clientMode==="external"?e.recipient.value.trim():"",fecha:e.date.value,proveedorId:e.signature.value,centrosTrabajo:centers};if(state.editingId){syncLines();return{...base,lineas:state.lines}}const concepts=$$('input[type=checkbox]:checked',e.concepts).map(input=>{const card=input.closest('.quote-check');return{id:input.value,cantidad:$('[data-role=qty]',card).value,precio:$('[data-role=price]',card).value,iva:$('[data-role=iva]',card).value}});return{...base,conceptos:concepts}}
    async function save(){try{e.save.disabled=true;feedback("Guardando primero la cotización y después sus conceptos...");const url=state.editingId?`/cotizaciones/api/cotizaciones/${encodeURIComponent(state.editingId)}`:'/cotizaciones/api/cotizaciones',r=await fetch(url,{method:state.editingId?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload())}),p=await r.json();if(!r.ok)throw new Error(p.error||"No se pudo guardar la cotización.");feedback(`Cotización guardada con ${p.data.conceptos} conceptos.`,"success");state.dirty=false;await loadWorkspace();await loadQuote(p.data.id)}catch(error){feedback(error.message,"error")}finally{e.save.disabled=false}}
    async function loadWorkspace(){const r=await fetch('/cotizaciones/api/workspace'),p=await r.json();if(!r.ok)throw new Error(p.error||"No se pudo cargar el módulo.");state.data=p.data;populate()}
    e.tabs.forEach(b=>b.addEventListener('click',()=>{if(b.dataset.tab==='editor'&&!state.editingId)resetEditor();setTab(b.dataset.tab)}));$$('[data-client-mode]').forEach(b=>b.addEventListener('click',()=>{setClientMode(b.dataset.clientMode);state.dirty=true}));e.search.addEventListener('input',renderQuotes);e.company.addEventListener('change',()=>{state.selectedCenters.clear();e.state.value="";renderStates();renderMunicipalities();renderCenters();state.dirty=true});e.state.addEventListener('change',()=>{renderMunicipalities();renderCenters()});e.municipality.addEventListener('change',renderCenters);e.centerSearch.addEventListener('input',renderCenters);e.externalCenters.addEventListener('input',()=>{renderCenters();if(state.editingId)renderLines()});e.conceptSearch.addEventListener('input',renderConcepts);e.save.addEventListener('click',save);e.cancel.addEventListener('click',()=>{resetEditor();setTab('list');const url=new URL(location.href);url.searchParams.delete('edit');history.replaceState({},"",url)});loadWorkspace().then(()=>{const id=new URLSearchParams(location.search).get('edit');if(id)loadQuote(id)}).catch(error=>e.list.innerHTML=`<div class="quote-empty">${esc(error.message)}</div>`);
  })();
  </script>
