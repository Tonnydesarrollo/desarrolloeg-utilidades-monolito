<!DOCTYPE html>
<html>
  <head>
    <base target="_top">
    <meta charset="UTF-8">
    <title>Cotizacion Editable</title>
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        padding: 20px;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
        background: #f3f4f6;
      }
      .page {
        max-width: 1100px;
        margin: 0 auto;
        background: #fff;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      }
      h1 {
        margin: 0 0 8px;
        font-size: 20px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }
      .subtitle {
        margin: 0 0 20px;
        font-size: 12px;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-weight: 700;
      }
      .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
      }
      .card {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 16px;
      }
      label {
        display: block;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #6b7280;
        margin-bottom: 6px;
        font-weight: 700;
      }
      input, select {
        width: 100%;
        padding: 12px;
        border: 2px solid #e5e7eb;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        outline: none;
        background: #fff;
      }
      input:focus, select:focus {
        border-color: #2563eb;
      }
      .row { margin-bottom: 14px; }
      .totales {
        display: grid;
        gap: 10px;
      }
      .tot-row {
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        font-weight: 600;
      }
      .tot-row.total {
        border-top: 2px solid #111827;
        padding-top: 8px;
        font-weight: 800;
        font-size: 16px;
      }
      .firma-box {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
        text-align: center;
      }
      .firma-img {
        height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px dashed #e5e7eb;
        border-radius: 12px;
        background: #fff;
      }
      .firma-img img {
        max-height: 80px;
      }
      .bank {
        font-size: 14px;
        line-height: 1.5;
        font-weight: 600;
      }
      .actions {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 14px;
      }
      .btn {
        padding: 10px 14px;
        border: 1px solid #2563eb;
        background: #2563eb;
        color: #fff;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
      }
      .btn:hover { background: #1e40af; }
      .no-print { }
      .desglose-toolbar,
      .desglose-preview {
        display: none;
      }
      .condiciones-preview {
        margin-top: 18px;
      }
      .condiciones-preview .card {
        background: #fff;
      }
      .condiciones-preview h2 {
        margin: 0 0 10px;
        font-size: 14px;
      }
      .condiciones-preview p,
      .condiciones-preview li {
        font-size: 13px;
        line-height: 1.5;
      }
      .desglose-tag {
        display: inline-block;
        margin-bottom: 8px;
        padding: 3px 8px;
        border-radius: 999px;
        background: #e8f1fb;
        color: #1f4e79;
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .desglose-temario {
        margin: 8px 0 0;
      }
      .desglose-temario li {
        margin-bottom: 8px;
      }
      @media (max-width: 860px) {
        .grid { grid-template-columns: 1fr; }
      }
      @media print {
        body { background: #fff; padding: 0; }
        .page { box-shadow: none; border-radius: 0; }
        .actions { display: none; }
        .no-print { display: none !important; }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <div class="actions">
        <button class="btn" onclick="window.print()">Imprimir / Guardar PDF</button>
      </div>
      <h1>Cotizacion Editable</h1>
      <div class="subtitle">Todos los campos editables</div>

      <div class="grid">
        <div class="card">
          <div class="row">
            <label>Sucursal</label>
            <input list="sucursales-list" id="sucursalInput" placeholder="Seleccionar o escribir sucursal">
            <datalist id="sucursales-list">
              <% (sucursales || []).forEach(function(s){ %>
                <option value="<%= s.nombre %>"></option>
              <% }) %>
            </datalist>
          </div>

          <div class="row">
            <label>Firma (seleccionable)</label>
            <select id="firmaSelect">
              <option value="">Seleccionar firma</option>
              <% (firmas || []).forEach(function(f, i){ %>
                <option
                  value="<%= i %>"
                  data-nombre="<%= f.nombre %>"
                  data-puesto="<%= f.puesto %>"
                  data-url="<%= f.firmaUrl %>"
                >
                  <%= f.nombre || "Sin nombre" %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="row">
            <label>Producto / Servicio</label>
            <input id="productoInput" placeholder="Ej. Capacitacion Brigadas">
          </div>

          <div class="row">
            <label>Tipo</label>
            <input id="tipoInput" placeholder="Ej. Servicio, Producto, Curso">
          </div>

          <div class="row">
            <label>Subtotal</label>
            <input id="subtotalInput" type="number" step="0.01" min="0" value="0">
          </div>

          <div class="row">
            <label>Forma de pago</label>
            <select id="formaPagoInput">
              <option value="dos_pagos">Dos pagos</option>
              <option value="una_exhibicion">Una sola exhibición</option>
            </select>
          </div>
        </div>

        <div class="card">
          <div class="row">
            <label>Resumen</label>
            <div class="totales">
              <div class="tot-row">
                <div>Subtotal</div>
                <div id="subtotalLabel">$0.00</div>
              </div>
              <div class="tot-row">
                <div>IVA (16%)</div>
                <div id="ivaLabel">$0.00</div>
              </div>
              <div class="tot-row total">
                <div>Total</div>
                <div id="totalLabel">$0.00</div>
              </div>
            </div>
          </div>

          <div class="row">
            <label>Firma seleccionada</label>
            <div class="firma-box">
              <div class="firma-img" id="firmaImgWrap">
                <span style="font-size:12px;color:#9ca3af;font-weight:700;">Sin firma</span>
              </div>
              <div id="firmaNombre" style="font-weight:700;">Sin nombre</div>
              <div id="firmaPuesto" style="font-size:12px;color:#6b7280;">&nbsp;</div>
            </div>
          </div>

          <div class="row">
            <label>Datos Bancarios</label>
            <div class="bank">
              Banco: BANORTE<br>
              CLABE: 072730012443208577<br>
              Cuenta: 1244320857
            </div>
          </div>
        </div>
      </div>

      <div class="desglose-toolbar no-print">
        <div class="desglose-card">
          <h2>Desglose opcional</h2>
          <div class="desglose-options">
            <label class="desglose-option">
              <input type="checkbox" id="desglosePipc">
              <div>
                <strong>PIPC</strong>
                <p>Programa Interno de Protección Civil con redacción, gestión y seguimiento del trámite.</p>
              </div>
            </label>
            <label class="desglose-option">
              <input type="checkbox" id="desgloseCapacitaciones">
              <div>
                <strong>Capacitación de Brigadas</strong>
                <p>Incluye capacitación multifuncional, constancias al término y temario en primeros auxilios, incendios y evacuación.</p>
              </div>
            </label>
          </div>
        </div>
      </div>

      <div class="desglose-preview" id="desglosePreview"></div>
      <div class="condiciones-preview" id="condicionesPreview"></div>
    </div>

    <script>
      (function() {
        var subtotalInput = document.getElementById('subtotalInput');
        var formaPagoInput = document.getElementById('formaPagoInput');
        var subtotalLabel = document.getElementById('subtotalLabel');
        var ivaLabel = document.getElementById('ivaLabel');
        var totalLabel = document.getElementById('totalLabel');
        var firmaSelect = document.getElementById('firmaSelect');
        var firmaImgWrap = document.getElementById('firmaImgWrap');
        var firmaNombre = document.getElementById('firmaNombre');
        var firmaPuesto = document.getElementById('firmaPuesto');
        var desglosePipc = document.getElementById('desglosePipc');
        var desgloseCapacitaciones = document.getElementById('desgloseCapacitaciones');
        var desglosePreview = document.getElementById('desglosePreview');
        var condicionesPreview = document.getElementById('condicionesPreview');
        var preselectedDesglose = <%- JSON.stringify((typeof desglose !== 'undefined' && Array.isArray(desglose)) ? desglose : []) %>;
        var desgloseCatalogo = {
    pipc: {
      tag: "PIPC",
      titulo: "PIPC (Programa Interno de Protección Civil)",
      intro: "Proporcionamos un servicio integral para la elaboración, gestión y tramitación del Programa Interno de Protección Civil ante la autoridad competente. El servicio comprende el desarrollo técnico del documento conforme a la normatividad aplicable, la integración y validación de la información requerida, así como el seguimiento puntual del proceso administrativo hasta la obtención de la opinión técnica correspondiente.",
      detalles: [
        "Incluye la elaboración del programa y la gestión ante la autoridad de Protección Civil.",
        "No incluye el pago de derechos correspondientes a la emisión de la opinión favorable."
      ]
    },
    capacitaciones: {
      tag: "Capacitación",
      titulo: "Capacitación de Brigadas",
      intro: "Brindamos un servicio integral de capacitación multifuncional, orientado al fortalecimiento de las capacidades del personal para la prevención y atención de emergencias. El servicio contempla la planeación, impartición y evaluación de los cursos, bajo un enfoque teórico-práctico y conforme a lineamientos técnicos y normativos vigentes en materia de Protección Civil. Al término de cada capacitación, se emite constancia de participación y/o acreditación para los asistentes.",
      detalles: [],
      temario: [
        "Primeros auxilios: Evaluación primaria de la escena, soporte básico de vida (RCP), control de hemorragias, atención de lesiones comunes y estabilización inicial de personas lesionadas.",
        "Prevención y combate de incendios: Identificación de riesgos, clasificación de fuegos, manejo y uso adecuado de extintores, así como técnicas básicas para el control y supresión de incendios en su fase inicial.",
        "Evacuación de inmuebles: Organización y funciones de brigadas, diseño y aplicación de rutas de evacuación, establecimiento de puntos de reunión y ejecución de protocolos de actuación ante situaciones de emergencia."
      ]
    }
  };

        function fmt(n) {
          if (!isFinite(n)) n = 0;
          return n.toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
        }

        function hasDesglose(key) {
          return preselectedDesglose.indexOf(key) !== -1;
        }

        function calc() {
          var val = parseFloat(subtotalInput.value || '0');
          if (!isFinite(val)) val = 0;
          var iva = val * 0.16;
          var total = val + iva;
          subtotalLabel.textContent = fmt(val);
          ivaLabel.textContent = fmt(iva);
          totalLabel.textContent = fmt(total);
        }

        function esPagoUnico(valor) {
          var normalizado = String(valor || '')
            .toLowerCase()
            .trim()
            .replace(/[_-]+/g, ' ')
            .replace(/\s+/g, ' ');

          return (
            normalizado === 'una exhibicion' ||
            normalizado === 'una sola exhibicion' ||
            normalizado === 'un pago' ||
            normalizado === 'un solo pago' ||
            normalizado === 'single' ||
            normalizado === '1' ||
            normalizado === 'contado'
          );
        }

        function renderCondiciones() {
          var pagoUnico = esPagoUnico(formaPagoInput.value);
          var html = '';
          html += '<div class="card">';
          html += '<h2>Condiciones comerciales</h2>';
          html += '<p><strong>Precios:</strong> Todos los precios se expresan en moneda nacional (MXN).</p>';
          html += '<p><strong>Forma de pago:</strong></p>';
          html += '<ul>';

          if (pagoUnico) {
            html += '<li>En una sola exhibición al iniciar el trabajo.</li>';
          } else {
            html += '<li>50 % de anticipo al aceptar la propuesta.</li>';
            html += '<li>50 % restante contra entrega o conforme a acuerdo entre las partes.</li>';
          }

          html += '</ul>';
          html += '<p><strong>Inicio del servicio:</strong> En una sola exhibición al iniciar el trabajo.</p>';
          html += '<p><strong>Tiempo de entrega:</strong> 30 días naturales, sujeto a necesidades operativas y a la disponibilidad de la información requerida.</p>';
          html += '<p><strong>Duración del proyecto:</strong> La duración total no deberá exceder los 60 días naturales.</p>';
          html += '<p><strong>Exclusiones:</strong></p>';
          html += '<ul>';
          html += '<li>No incluye fianzas de cumplimiento.</li>';
          html += '<li>No se facturan ni comprueban pagos realizados por terceros.</li>';
          html += '</ul>';
          html += '</div>';

          condicionesPreview.innerHTML = html;
        }

        function updateFirma() {
          var opt = firmaSelect.options[firmaSelect.selectedIndex];
          if (!opt || !opt.getAttribute) return;
          var nombre = opt.getAttribute('data-nombre') || 'Sin nombre';
          var puesto = opt.getAttribute('data-puesto') || '';
          var url = opt.getAttribute('data-url') || '';

          firmaNombre.textContent = nombre || 'Sin nombre';
          firmaPuesto.textContent = puesto || ' ';

          if (url) {
            firmaImgWrap.innerHTML = '<img src="' + url + '" alt="Firma">';
          } else {
            firmaImgWrap.innerHTML = '<span style="font-size:12px;color:#9ca3af;font-weight:700;">Sin firma</span>';
          }
        }

        function renderDesglose() {
          var selected = [];
          if (desglosePipc.checked) selected.push('pipc');
          if (desgloseCapacitaciones.checked) selected.push('capacitaciones');

          if (!selected.length) {
            desglosePreview.innerHTML = '';
            return;
          }

          var html = '<div class="card">';
          html += '<div class="desglose-card">';
          html += '<h2>Desglose adjunto</h2>';

          selected.forEach(function(key) {
            var item = desgloseCatalogo[key];
            if (!item) return;
            html += '<div class="info-box desglose-item">';
            html += '<div class="desglose-tag">' + item.tag + '</div>';
            html += '<h3>' + item.titulo + '</h3>';
            if (item.intro) {
              html += '<p>' + item.intro + '</p>';
            }
            if (item.detalles && item.detalles.length) {
              html += '<ul>';
              item.detalles.forEach(function(text) {
                html += '<li>' + text + '</li>';
              });
              html += '</ul>';
            }
            if (item.temario && item.temario.length) {
              html += '<p><strong>Temario:</strong></p>';
              html += '<ul class="desglose-temario">';
              item.temario.forEach(function(text) {
                html += '<li>' + text + '</li>';
              });
              html += '</ul>';
            }
            html += '</div>';
          });

          html += '</div>';
          html += '</div>';
          desglosePreview.innerHTML = html;
        }

        subtotalInput.addEventListener('input', calc);
        formaPagoInput.addEventListener('change', renderCondiciones);
        firmaSelect.addEventListener('change', updateFirma);
        desglosePipc.addEventListener('change', renderDesglose);
        desgloseCapacitaciones.addEventListener('change', renderDesglose);

        desglosePipc.checked = hasDesglose('pipc');
        desgloseCapacitaciones.checked = hasDesglose('capacitaciones');
        formaPagoInput.value = 'dos_pagos';
        calc();
        updateFirma();
        renderDesglose();
        renderCondiciones();
      })();
    </script>
  </body>
</html>

