<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Trabajos <%= tipo %> | Desarrollo EG</title>
  <link rel="stylesheet" href="/ui/portal-shell.css?v=20260907a">
  <style>
    :root{--work-ink:#132838;--work-muted:#647484;--work-line:rgba(31,62,82,.14);--work-accent:<%= tipo === 'estatales' ? '#ba332b' : '#0f5961' %>}
    *{box-sizing:border-box}body.work-page{overflow-x:hidden}.work-shell{display:grid;gap:16px;padding-bottom:90px!important}.work-page.is-embedded{background:transparent}.work-page.is-embedded .work-shell{width:100%;max-width:none;padding:0 2px 90px!important}.work-page.is-embedded .work-hero{display:none}
    .work-hero{padding:30px;border-radius:28px;color:#fff;background:linear-gradient(130deg,#102f42,var(--work-accent));box-shadow:0 24px 55px rgba(18,45,62,.18)}.work-hero small{font:800 .7rem/1 var(--portal-font-ui);letter-spacing:.14em;text-transform:uppercase}.work-hero h1{margin:10px 0 6px;font:700 clamp(2rem,4vw,3.5rem)/1 var(--portal-font-display)}.work-hero p{margin:0;color:rgba(255,255,255,.76)}
    .work-filters{display:grid;grid-template-columns:140px minmax(200px,.8fr) minmax(180px,.7fr) minmax(240px,1.3fr) auto;gap:10px;padding:15px;border:1px solid var(--work-line);border-radius:20px;background:rgba(255,255,255,.9)}.work-field{display:grid;gap:6px}.work-field span{font:800 .62rem/1 var(--portal-font-ui);letter-spacing:.09em;text-transform:uppercase;color:var(--work-muted)}.work-field input,.work-field select{min-height:44px;padding:0 12px;border:1px solid var(--work-line);border-radius:12px;background:#f8fafc;color:var(--work-ink);font-weight:700}.work-refresh{align-self:end;min-height:44px;padding:0 16px;border:0;border-radius:12px;background:var(--work-accent);color:#fff;font-weight:900;text-transform:uppercase;cursor:pointer}
    .work-summary{display:flex;justify-content:space-between;align-items:end;gap:14px}.work-summary h2{margin:0;font:700 clamp(1.4rem,3vw,2rem)/1 var(--portal-font-display);color:var(--work-ink)}.work-summary span{padding:9px 13px;border-radius:999px;background:color-mix(in srgb,var(--work-accent) 10%,white);color:var(--work-accent);font-weight:900}.work-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.work-card{display:grid;grid-template-columns:1fr auto;gap:12px;padding:17px;border:1px solid var(--work-line);border-left:4px solid var(--work-accent);border-radius:17px;background:rgba(255,255,255,.93);box-shadow:0 12px 28px rgba(20,50,70,.06)}.work-card h3{margin:0;color:var(--work-ink);font:800 .95rem/1.3 var(--portal-font-ui)}.work-card p{margin:5px 0 0;color:var(--work-muted);font-size:.74rem}.work-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:11px}.work-tag{padding:6px 8px;border-radius:999px;background:#eef3f5;color:var(--work-ink);font:800 .62rem/1 var(--portal-font-ui)}.work-drive{align-self:start;padding:9px 11px;border-radius:10px;color:#fff!important;background:var(--work-accent);font:800 .65rem/1 var(--portal-font-ui);text-decoration:none}.work-empty{grid-column:1/-1;padding:40px;border:1px dashed var(--work-line);border-radius:18px;text-align:center;color:var(--work-muted);background:rgba(255,255,255,.8)}
    @media(max-width:900px){.work-filters{grid-template-columns:1fr 1fr}.work-field-search{grid-column:1/-1}.work-grid{grid-template-columns:1fr}}@media(max-width:580px){.work-filters{grid-template-columns:1fr}.work-field-search{grid-column:auto}.work-card{grid-template-columns:1fr}.work-drive{justify-self:start}}
  </style>
</head>
<body class="portal-shell work-page<%= embedded ? ' is-embedded' : '' %>">
  <main class="page work-shell">
    <header class="work-hero"><small>Tabla operativa local</small><h1>Trabajos <%= tipo %></h1><p>Expedientes sincronizados directamente desde <%= tipo === 'estatales' ? 'ESTATALES' : 'MUNICIPALES' %>.</p></header>
    <section class="work-filters">
      <label class="work-field"><span>Ano</span><select id="workYear"></select></label>
      <label class="work-field"><span>Empresa</span><select id="workCompany"><option value="">Todas</option></select></label>
      <label class="work-field"><span>Estatus</span><select id="workStatus"><option value="">Todos</option></select></label>
      <label class="work-field work-field-search"><span>Buscar</span><input id="workSearch" type="search" placeholder="Sucursal, tienda o municipio"></label>
      <button class="work-refresh" id="workRefresh" type="button">Actualizar</button>
    </section>
    <div class="work-summary"><div><h2>Expedientes <%= tipo %></h2><p id="workSource">Cargando base local...</p></div><span id="workCount">0 registros</span></div>
    <section class="work-grid" id="workResults"><div class="work-empty">Cargando expedientes...</div></section>
  </main>
  <script>
    (()=>{const tipo=<%- JSON.stringify(tipo) %>,state={year:"",empresa:"",status:"",q:"",controller:null,ready:false};const $=id=>document.getElementById(id),els={year:$("workYear"),company:$("workCompany"),status:$("workStatus"),search:$("workSearch"),refresh:$("workRefresh"),results:$("workResults"),count:$("workCount"),source:$("workSource")};const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
      const card=item=>`<article class="work-card"><div><h3>${esc(item.sucursal)}</h3><p>${esc([item.empresa,item.municipio,item.estado].filter(Boolean).join(" · "))}</p><div class="work-tags"><span class="work-tag">${esc(item.status)}</span>${item.fecha?`<span class="work-tag">${esc(item.fecha)}</span>`:""}${item.capacitadores?`<span class="work-tag">${esc(item.capacitadores)}</span>`:""}${item.statusCapacitacion?`<span class="work-tag">Capacitacion: ${esc(item.statusCapacitacion)}</span>`:""}</div></div>${item.drive?`<a class="work-drive" href="${esc(item.drive)}" target="_blank" rel="noreferrer">Drive</a>`:""}</article>`;
      async function load(){state.controller?.abort();state.controller=new AbortController();els.refresh.disabled=true;try{const params=new URLSearchParams({year:state.year,empresa:state.empresa,status:state.status,q:state.q});const response=await fetch(`/trabajos/api/${tipo}?${params}`,{cache:"no-store",signal:state.controller.signal});const payload=await response.json();if(!response.ok||!payload.ok)throw new Error(payload.error||"No se pudo cargar");const data=payload.data;state.year=String(data.selectedYear);if(!state.ready){els.year.innerHTML=data.years.map(y=>`<option value="${y}">${y}</option>`).join("");els.company.innerHTML=`<option value="">Todas</option>`+data.companies.map(c=>`<option value="${esc(c.id)}">${esc(c.label)}</option>`).join("");state.ready=true}els.year.value=state.year;els.status.innerHTML=`<option value="">Todos</option>`+data.statuses.map(s=>`<option value="${esc(s)}"${s===state.status?" selected":""}>${esc(s)}</option>`).join("");els.count.textContent=`${data.total} ${data.total===1?"registro":"registros"}`;els.source.textContent=`${data.table} · base local`;els.results.innerHTML=data.items.length?data.items.map(card).join(""):`<div class="work-empty">No hay expedientes con estos filtros.</div>`}catch(error){if(error.name!=="AbortError")els.results.innerHTML=`<div class="work-empty">${esc(error.message)}</div>`}finally{els.refresh.disabled=false}}
      els.year.addEventListener("change",()=>{state.year=els.year.value;state.status="";load()});els.company.addEventListener("change",()=>{state.empresa=els.company.value;load()});els.status.addEventListener("change",()=>{state.status=els.status.value;load()});let timer;els.search.addEventListener("input",()=>{clearTimeout(timer);timer=setTimeout(()=>{state.q=els.search.value.trim();load()},250)});els.refresh.addEventListener("click",load);load();
      <% if (embedded) { %>const resize=()=>parent.postMessage({type:"desarrolloeg:trabajos-height",tipo,height:document.documentElement.scrollHeight},"*");new ResizeObserver(resize).observe(document.documentElement);<% } %>
    })();
  </script>
  <% if (!embedded) { %><script src="/ui/portal-shell.js?v=20260907b" defer></script><% } %>
</body>
</html>
