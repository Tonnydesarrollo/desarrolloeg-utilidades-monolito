<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Trabajos <%= tipo %> | Desarrollo EG</title>
  <link rel="stylesheet" href="/ui/portal-shell.css?v=20260907c">
  <style>
    :root{--work-ink:#132838;--work-muted:#647484;--work-line:rgba(31,62,82,.14);--work-accent:<%= tipo === 'estatales' ? '#ba332b' : '#0f5961' %>}
    *{box-sizing:border-box}body.work-page{overflow-x:hidden}.work-shell{display:grid;gap:16px;padding-bottom:90px!important}.work-page.is-embedded{background:transparent}.work-page.is-embedded .work-shell{width:100%;max-width:none;padding:0 2px 90px!important}.work-page.is-embedded .work-hero{display:none}
    .work-hero{padding:30px;border-radius:28px;color:#fff;background:linear-gradient(130deg,#102f42,var(--work-accent));box-shadow:0 24px 55px rgba(18,45,62,.18)}.work-hero small,.work-eyebrow{font:800 .68rem/1 var(--portal-font-ui);letter-spacing:.13em;text-transform:uppercase}.work-hero h1{margin:10px 0 6px;font:700 clamp(2rem,4vw,3.5rem)/1 var(--portal-font-display)}.work-hero p{margin:0;color:rgba(255,255,255,.76)}
    .work-filters{display:grid;grid-template-columns:120px minmax(190px,.9fr) minmax(170px,.7fr) minmax(170px,.7fr) minmax(220px,1.1fr) auto;gap:10px;padding:15px;border:1px solid var(--work-line);border-radius:20px;background:rgba(255,255,255,.9)}.work-field{display:grid;gap:6px}.work-field span{font:800 .62rem/1 var(--portal-font-ui);letter-spacing:.09em;text-transform:uppercase;color:var(--work-muted)}.work-field input,.work-field select,.work-status-select{min-height:44px;padding:0 12px;border:1px solid var(--work-line);border-radius:12px;background:#f8fafc;color:var(--work-ink);font-weight:700}.work-refresh{align-self:end;min-height:44px;padding:0 16px;border:0;border-radius:12px;background:var(--work-accent);color:#fff;font-weight:900;text-transform:uppercase;cursor:pointer}
    .work-summary{display:flex;justify-content:space-between;align-items:end;gap:14px}.work-summary h2{margin:0;font:700 clamp(1.4rem,3vw,2rem)/1 var(--portal-font-display);color:var(--work-ink)}.work-summary p{margin:5px 0 0;color:var(--work-muted)}.work-count{padding:9px 13px;border-radius:999px;background:color-mix(in srgb,var(--work-accent) 10%,white);color:var(--work-accent);font-weight:900}
    .work-groups{display:grid;gap:12px}.company-group{overflow:hidden;border:1px solid var(--work-line);border-radius:22px;background:rgba(255,255,255,.9);box-shadow:0 14px 32px rgba(20,50,70,.06)}.company-group>summary{display:grid;grid-template-columns:52px 1fr auto auto;align-items:center;gap:14px;padding:16px 18px;cursor:pointer;list-style:none}.company-group>summary::-webkit-details-marker{display:none}.company-logo{width:52px;height:52px;padding:5px;border:1px solid var(--work-line);border-radius:15px;background:#fff;object-fit:contain}.company-logo-fallback{display:grid;place-items:center;background:var(--work-accent);color:#fff;font-weight:900}.company-name strong{display:block;color:var(--work-ink);font:800 1rem/1.2 var(--portal-font-ui)}.company-name small{display:block;margin-top:4px;color:var(--work-muted)}.company-total{padding:7px 10px;border-radius:999px;background:#eef3f5;color:var(--work-ink);font:800 .68rem/1 var(--portal-font-ui)}.company-chevron{font-size:1.2rem;transition:transform .2s}.company-group[open] .company-chevron{transform:rotate(180deg)}.company-items{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;padding:0 14px 14px;border-top:1px solid var(--work-line)}
    .work-card{margin-top:14px;padding:16px;border:1px solid var(--work-line);border-left:4px solid var(--work-accent);border-radius:17px;background:#fff}.work-card-head{display:flex;justify-content:space-between;align-items:start;gap:12px}.work-card h3{margin:0;color:var(--work-ink);font:800 .96rem/1.3 var(--portal-font-ui)}.work-card p{margin:5px 0 0;color:var(--work-muted);font-size:.76rem}.work-status-select{min-height:36px;width:145px;padding:0 9px;font-size:.7rem;text-transform:uppercase}.work-status-virtual{padding:8px 10px;border-radius:10px;background:#fff1d8;color:#8b4e00;font:900 .64rem/1 var(--portal-font-ui)}.work-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}.work-tag{padding:6px 8px;border-radius:999px;background:#eef3f5;color:var(--work-ink);font:800 .62rem/1 var(--portal-font-ui)}.work-tag.training{background:#e8f5ee;color:#17603a}.work-actions{display:flex;align-items:center;gap:8px;margin-top:13px}.work-drive,.work-save{padding:9px 11px;border:0;border-radius:10px;color:#fff!important;background:var(--work-accent);font:800 .65rem/1 var(--portal-font-ui);text-decoration:none;cursor:pointer}.work-docs{margin-top:12px;border-top:1px solid var(--work-line);padding-top:11px}.work-docs>summary{cursor:pointer;color:var(--work-accent);font:900 .7rem/1.4 var(--portal-font-ui);list-style:none}.work-docs>summary::-webkit-details-marker{display:none}.work-checklist{display:grid;gap:7px;margin-top:11px}.work-check{display:flex;align-items:flex-start;gap:8px;color:var(--work-ink);font-size:.76rem}.work-check input{margin-top:2px;accent-color:var(--work-accent)}.work-empty{padding:40px;border:1px dashed var(--work-line);border-radius:18px;text-align:center;color:var(--work-muted);background:rgba(255,255,255,.8)}.work-toast{position:fixed;right:18px;bottom:18px;z-index:20;max-width:360px;padding:13px 16px;border-radius:14px;background:#132838;color:#fff;box-shadow:0 18px 40px rgba(0,0,0,.2);font-weight:700}.work-toast.error{background:#9c2d28}
    @media(max-width:1050px){.work-filters{grid-template-columns:repeat(3,1fr)}.work-field-search{grid-column:span 2}}@media(max-width:760px){.work-filters{grid-template-columns:1fr 1fr}.work-field-search{grid-column:1/-1}.company-items{grid-template-columns:1fr}}@media(max-width:520px){.work-filters{grid-template-columns:1fr}.work-field-search{grid-column:auto}.company-group>summary{grid-template-columns:46px 1fr auto}.company-total{grid-column:2}.company-chevron{grid-column:3;grid-row:1/3}.work-card-head{display:grid}.work-status-select{width:100%}}
  </style>
</head>
<body class="portal-shell work-page<%= embedded ? ' is-embedded' : '' %>">
  <main class="page work-shell">
    <header class="work-hero"><small>Tabla operativa local</small><h1>Trabajos <%= tipo %></h1><p>Seguimiento de expedientes, capacitación y documentación por empresa.</p></header>
    <section class="work-filters" aria-label="Filtros de trabajos">
      <label class="work-field"><span>Año</span><select id="workYear"></select></label>
      <label class="work-field"><span>Empresa</span><select id="workCompany"><option value="">Todas</option></select></label>
      <label class="work-field"><span>Estatus</span><select id="workStatus"><option value="">Todos</option></select></label>
      <label class="work-field"><span>Capacitación</span><select id="workTraining"><option value="">Todas</option></select></label>
      <label class="work-field work-field-search"><span>Buscar</span><input id="workSearch" type="search" placeholder="Sucursal, empresa o municipio"></label>
      <button class="work-refresh" id="workRefresh" type="button">Actualizar</button>
    </section>
    <div class="work-summary"><div><h2>Expedientes <%= tipo %></h2><p id="workSource">Cargando base local...</p></div><span class="work-count" id="workCount">0 registros</span></div>
    <section class="work-groups" id="workResults"><div class="work-empty">Cargando expedientes...</div></section>
  </main>
  <script>
    (()=>{const tipo=<%- JSON.stringify(tipo) %>,state={year:"",empresa:"",status:"",capacitacion:"",q:"",controller:null,ready:false};const $=id=>document.getElementById(id),els={year:$("workYear"),company:$("workCompany"),status:$("workStatus"),training:$("workTraining"),search:$("workSearch"),refresh:$("workRefresh"),results:$("workResults"),count:$("workCount"),source:$("workSource")};const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
      const statuses=["PENDIENTE","EN DRIVE","IMPRESO","ENTREGADO"];
      function toast(message,error=false){document.querySelector(".work-toast")?.remove();const node=document.createElement("div");node.className=`work-toast${error?" error":""}`;node.textContent=message;document.body.append(node);setTimeout(()=>node.remove(),3500)}
      const docs=(item,options)=>item.virtual?"":`<details class="work-docs"><summary>${item.missingDocuments.length?`${item.missingDocuments.length} documentos pendientes`:`Documentación completa`} · Ver checklist</summary><div class="work-checklist">${options.map(doc=>`<label class="work-check"><input type="checkbox" value="${esc(doc.id)}"${item.selectedDocuments.includes(doc.id)?" checked":""}><span>${esc(doc.label)}</span></label>`).join("")||`<p>El catálogo de documentación aún no está sincronizado.</p>`}</div>${options.length?`<div class="work-actions"><button class="work-save" type="button" data-save-docs>Guardar documentación</button></div>`:""}</details>`;
      const card=(item,options)=>`<article class="work-card"${item.id?` data-row-id="${esc(item.id)}"`:""}><div class="work-card-head"><div><h3>${esc(item.sucursal)}</h3><p>${esc([item.municipio,item.estado].filter(Boolean).join(" · "))}</p></div>${item.virtual?`<span class="work-status-virtual">PENDIENTE DE CREAR</span>`:`<select class="work-status-select" data-status aria-label="Estatus de ${esc(item.sucursal)}">${statuses.map(status=>`<option${status===item.status?" selected":""}>${status}</option>`).join("")}</select>`}</div><div class="work-tags">${item.fecha?`<span class="work-tag">Creado ${esc(item.fecha)}</span>`:""}<span class="work-tag training">${esc(item.capacitacionStatus)}</span>${item.capacitacionFecha?`<span class="work-tag">Capacitación ${esc(item.capacitacionFecha)}</span>`:""}${item.capacitadores?`<span class="work-tag">${esc(item.capacitadores)}</span>`:""}</div>${item.drive?`<div class="work-actions"><a class="work-drive" href="${esc(item.drive)}" target="_blank" rel="noreferrer">Abrir Drive</a></div>`:""}${docs(item,options)}</article>`;
      const group=(company,options)=>`<details class="company-group" data-company-id="${esc(company.id)}"><summary>${company.logo?`<img class="company-logo" src="${esc(company.logo)}" alt="" loading="lazy" data-logo-initial="${esc(company.name.slice(0,1))}">`:`<span class="company-logo company-logo-fallback">${esc(company.name.slice(0,1))}</span>`}<span class="company-name"><strong>${esc(company.name)}</strong>${company.businessName&&company.businessName!==company.name?`<small>${esc(company.businessName)}</small>`:""}</span><span class="company-total">${company.total} ${company.total===1?"sucursal":"sucursales"}</span><span class="company-chevron" aria-hidden="true">⌄</span></summary><div class="company-items">${company.items.map(item=>card(item,options)).join("")}</div></details>`;
      function bindLogoFallbacks(){els.results.querySelectorAll("img[data-logo-initial]").forEach(image=>{const fallback=()=>{const node=document.createElement("span");node.className="company-logo company-logo-fallback";node.textContent=image.dataset.logoInitial||"E";image.replaceWith(node)};image.addEventListener("error",fallback,{once:true});if(image.complete&&!image.naturalWidth)fallback()})}
      async function save(cardNode,body){const rowId=cardNode.dataset.rowId;if(!rowId)return;cardNode.setAttribute("aria-busy","true");try{const response=await fetch(`/trabajos/api/${tipo}/${encodeURIComponent(rowId)}`,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});const payload=await response.json();if(!response.ok||!payload.ok)throw new Error(payload.error||"No se pudo guardar");toast("Cambio guardado en AppSheet y en la base local.");await load()}catch(error){toast(error.message,true)}finally{cardNode.removeAttribute("aria-busy")}}
      async function load(){const openCompanies=new Set([...els.results.querySelectorAll(".company-group[open]")].map(node=>node.dataset.companyId));state.controller?.abort();state.controller=new AbortController();els.refresh.disabled=true;try{const params=new URLSearchParams({year:state.year,empresa:state.empresa,status:state.status,capacitacion:state.capacitacion,q:state.q});const response=await fetch(`/trabajos/api/${tipo}?${params}`,{cache:"no-store",signal:state.controller.signal});const payload=await response.json();if(!response.ok||!payload.ok)throw new Error(payload.error||"No se pudo cargar");const data=payload.data;state.year=String(data.selectedYear);if(!state.ready){els.year.innerHTML=data.years.map(y=>`<option value="${y}">${y}</option>`).join("");els.company.innerHTML=`<option value="">Todas las empresas</option>`+data.companies.map(c=>`<option value="${esc(c.id)}">${esc(c.label)}</option>`).join("");els.training.innerHTML=`<option value="">Todas</option>`+data.trainingStatuses.map(value=>`<option>${esc(value)}</option>`).join("");state.ready=true}els.year.value=state.year;els.company.value=state.empresa;els.training.value=state.capacitacion;els.status.innerHTML=`<option value="">Todos</option>`+data.statuses.map(s=>`<option value="${esc(s)}"${s===state.status?" selected":''}>${esc(s)}</option>`).join("");els.count.textContent=`${data.total} ${data.total===1?"registro":"registros"}`;els.source.textContent=`${data.table} · base local`;els.results.innerHTML=data.groups.length?data.groups.map(company=>group(company,data.documentOptions)).join(""):`<div class="work-empty">No hay sucursales con estos filtros.</div>`;els.results.querySelectorAll(".company-group").forEach(node=>{node.open=openCompanies.has(node.dataset.companyId)});bindLogoFallbacks()}catch(error){if(error.name!=="AbortError")els.results.innerHTML=`<div class="work-empty">${esc(error.message)}</div>`}finally{els.refresh.disabled=false}}
      els.results.addEventListener("change",event=>{const select=event.target.closest("[data-status]");if(select)save(select.closest(".work-card"),{status:select.value})});els.results.addEventListener("click",event=>{const button=event.target.closest("[data-save-docs]");if(!button)return;const cardNode=button.closest(".work-card");const documents=[...cardNode.querySelectorAll('.work-check input:checked')].map(input=>input.value);save(cardNode,{documents})});
      els.year.addEventListener("change",()=>{state.year=els.year.value;state.status="";load()});els.company.addEventListener("change",()=>{state.empresa=els.company.value;load()});els.status.addEventListener("change",()=>{state.status=els.status.value;load()});els.training.addEventListener("change",()=>{state.capacitacion=els.training.value;load()});let timer;els.search.addEventListener("input",()=>{clearTimeout(timer);timer=setTimeout(()=>{state.q=els.search.value.trim();load()},250)});els.refresh.addEventListener("click",load);load();
      if("EventSource" in window){const events=new EventSource("/api/app-shell/events?scope=portal");events.addEventListener("app-shell-cache",()=>load());window.addEventListener("beforeunload",()=>events.close(),{once:true})}
      <% if (embedded) { %>const resize=()=>parent.postMessage({type:"desarrolloeg:trabajos-height",tipo,height:document.documentElement.scrollHeight},"*");new ResizeObserver(resize).observe(document.documentElement);<% } %>
    })();
  </script>
  <% if (!embedded) { %><script src="/ui/portal-shell.js?v=20260907c" defer></script><% } %>
</body>
</html>
